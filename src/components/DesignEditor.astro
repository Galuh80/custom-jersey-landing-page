---
import { designPresets } from "../data/designs";

// Realistic 3D jersey editor with GLTF model (shirt_baked.glb).
// Falls back to a procedural mesh if the GLTF fails to load.

interface Props {
    badge?: string;
    heading?: string;
    subheading?: string;
    fullPage?: boolean;
}

const {
    badge = "Design Editor · 3D",
    heading = "Buat Desain Jersey-mu",
    subheading = "Pilih desain, atur warna, garis, dan logo. Preview 3D realistis. Export ke PNG lalu kirim ke kami untuk produksi.",
    fullPage = false,
} = Astro.props;
---

<section
    id="design-editor"
    data-full-page={fullPage ? "true" : "false"}
    class:list={[
        "bg-dark-900/60 border-y border-white/5",
        fullPage
            ? "editor-full-page h-[calc(100dvh-4.5rem)] min-h-[620px] overflow-hidden"
            : "py-16 md:py-24",
    ]}
>
    <div
        class:list={[
            "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
            fullPage ? "editor-full-page-inner h-full max-w-none px-0" : "",
        ]}
    >
        <div class:list={["text-center mb-10 md:mb-14 reveal", fullPage ? "hidden" : ""]}>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300 text-sm font-medium mb-4">
                {badge}
            </div>
            <h2 class="font-display text-3xl md:text-4xl font-bold mb-3">
                {heading}
            </h2>
            <p class="text-white/60 max-w-2xl mx-auto text-sm md:text-base">
                {subheading}
            </p>
            {!fullPage && (
                <div class="mt-4">
                    <a
                        href="/editor"
                        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-400 hover:text-brand-300 transition"
                    >
                        Buka editor halaman penuh →
                    </a>
                </div>
            )}
        </div>

        <div
            class:list={[
                "grid gap-6 lg:gap-8",
                fullPage
                    ? "editor-full-page-grid h-full min-h-0"
                    : "lg:grid-cols-5",
            ]}
        >
            <!-- Controls -->
            <div
                class:list={[
                    "space-y-4 editor-panel reveal min-w-0",
                    fullPage
                        ? "editor-full-page-controls h-full min-h-0 overflow-y-auto border-l border-white/10 bg-dark-950 px-4 py-5 sm:px-6"
                        : "lg:col-span-2 order-2 lg:order-1",
                ]}
            >
                <div class="bg-dark-800/70 border border-white/5 rounded-2xl p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="font-display font-semibold text-sm text-white/80">
                            Pilih Desain
                        </h3>
                        <span
                            id="design-count"
                            class="text-xs text-white/30"
                        ></span>
                    </div>
                    <div
                        id="zone-selector"
                        class="flex flex-wrap gap-1.5 mb-3"
                    >
                        <button
                            type="button"
                            data-zone="all"
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition bg-brand-500 text-dark-950"
                        >
                            Semua
                        </button>
                        <button
                            type="button"
                            data-zone="front"
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition bg-white/5 text-white/60 hover:bg-white/10"
                        >
                            Depan
                        </button>
                        <button
                            type="button"
                            data-zone="back"
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition bg-white/5 text-white/60 hover:bg-white/10"
                        >
                            Belakang
                        </button>
                        <button
                            type="button"
                            data-zone="sleeveLeft"
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition bg-white/5 text-white/60 hover:bg-white/10"
                        >
                            Lengan L
                        </button>
                        <button
                            type="button"
                            data-zone="sleeveRight"
                            class="px-2.5 py-1 rounded-lg text-xs font-medium transition bg-white/5 text-white/60 hover:bg-white/10"
                        >
                            Lengan R
                        </button>
                    </div>
                    <div
                        id="design-grid"
                        class="grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-4 gap-2"
                    >
                    </div>
                    <p class="text-xs text-white/35 mt-3 leading-relaxed">
                        Pilih zona, lalu terapkan desain/warna hanya ke bagian
                        itu. <span class="text-white/60">Semua</span> mengubah
                        seluruh jersey.
                    </p>
                </div>

                <div class="bg-dark-800/70 border border-white/5 rounded-2xl p-5">
                    <h3 class="font-display font-semibold text-sm mb-3 text-white/80">
                        Warna Dasar
                    </h3>

                    <input type="hidden" id="color-base" value="#fef013" />

                    <div
                        class="relative rounded-xl overflow-hidden border border-white/10 select-none touch-none"
                    >
                        <canvas
                            id="color-plate"
                            width="300"
                            height="160"
                            class="w-full h-40 block cursor-crosshair"
                        ></canvas>
                        <div
                            id="plate-cursor"
                            class="absolute w-4 h-4 -ml-2 -mt-2 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(0,0,0,0.4)] pointer-events-none"
                        ></div>
                    </div>

                    <div
                        id="hue-slider"
                        class="relative h-3.5 rounded-full mt-3 cursor-pointer touch-none"
                        style="background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);"
                    >
                        <div
                            id="hue-thumb"
                            class="absolute top-1/2 w-4 h-4 -ml-2 -mt-2 rounded-full bg-white border-2 border-dark-950/60 shadow pointer-events-none"
                        ></div>
                    </div>

                    <div class="flex items-center gap-2 mt-4">
                        <div
                            id="color-swatch"
                            class="w-9 h-9 rounded-lg border border-white/20 shrink-0"
                        >
                        </div>
                        <div class="flex-1 min-w-0">
                            <label class="text-xs text-white/40 block mb-1"
                                >HEX</label
                            >
                            <div class="flex items-center gap-2">
                                <input
                                    id="hex-input"
                                    type="text"
                                    value="#fef013"
                                    maxlength="7"
                                    class="w-full min-w-0 bg-dark-900/60 border border-white/10 rounded-lg px-3 py-1.5 text-sm font-mono text-white/90 focus:outline-none focus:border-brand-500/50"
                                />
                                <button
                                    type="button"
                                    id="hex-copy"
                                    title="Salin HEX"
                                    class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 hover:bg-white/10 text-white/60 transition"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="w-4 h-4"
                                    >
                                        <rect
                                            x="9"
                                            y="9"
                                            width="13"
                                            height="13"
                                            rx="2"></rect>
                                        <path
                                            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                                        ></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 mt-3 text-xs">
                        <div class="bg-dark-900/50 rounded-lg px-3 py-2">
                            <div class="text-white/35 mb-0.5">RGB</div>
                            <div id="val-rgb" class="font-mono text-white/80">
                                254, 240, 19
                            </div>
                        </div>
                        <div class="bg-dark-900/50 rounded-lg px-3 py-2">
                            <div class="text-white/35 mb-0.5">CMYK</div>
                            <div id="val-cmyk" class="font-mono text-white/80">
                                0%, 6%, 93%, 0%
                            </div>
                        </div>
                        <div class="bg-dark-900/50 rounded-lg px-3 py-2">
                            <div class="text-white/35 mb-0.5">HSV</div>
                            <div id="val-hsv" class="font-mono text-white/80">
                                56°, 93%, 100%
                            </div>
                        </div>
                        <div class="bg-dark-900/50 rounded-lg px-3 py-2">
                            <div class="text-white/35 mb-0.5">HSL</div>
                            <div id="val-hsl" class="font-mono text-white/80">
                                56°, 97%, 54%
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <input
                            type="range"
                            id="brightness"
                            min="40"
                            max="100"
                            value="100"
                            class="editor-slider w-full"
                        />
                        <p class="text-xs text-white/40 mt-1">Brightness</p>
                    </div>

                    <div class="flex flex-wrap gap-2 mt-3" id="preset-colors">
                        <button
                            data-color="#fef013"
                            class="w-8 h-8 rounded-lg bg-[#fef013] border-2 border-white/30 hover:scale-110 transition"
                            title="Kuning"
                        ></button>
                        <button
                            data-color="#ef4444"
                            class="w-8 h-8 rounded-lg bg-red-500 border-2 border-transparent hover:scale-110 transition"
                            title="Red"
                        ></button>
                        <button
                            data-color="#22c55e"
                            class="w-8 h-8 rounded-lg bg-green-500 border-2 border-transparent hover:scale-110 transition"
                            title="Green"
                        ></button>
                        <button
                            data-color="#eab308"
                            class="w-8 h-8 rounded-lg bg-yellow-500 border-2 border-transparent hover:scale-110 transition"
                            title="Yellow"
                        ></button>
                        <button
                            data-color="#1e293b"
                            class="w-8 h-8 rounded-lg bg-slate-800 border-2 border-transparent hover:scale-110 transition"
                            title="Dark"
                        ></button>
                        <button
                            data-color="#ffffff"
                            class="w-8 h-8 rounded-lg bg-white border-2 border-transparent hover:scale-110 transition"
                            title="White"
                        ></button>
                        <button
                            data-color="#000000"
                            class="w-8 h-8 rounded-lg bg-black border-2 border-transparent hover:scale-110 transition"
                            title="Black"
                        ></button>
                        <button
                            data-color="#7c3aed"
                            class="w-8 h-8 rounded-lg bg-violet-600 border-2 border-transparent hover:scale-110 transition"
                            title="Violet"
                        ></button>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="bg-dark-800/70 border border-white/5 rounded-2xl p-5 flex flex-col">
                        <h3 class="font-display font-semibold text-sm mb-3 text-white/80">
                            Garis & Aksen
                        </h3>
                        <div class="space-y-3 flex-1">
                            <div>
                                <label class="text-sm text-white/60 block mb-2">
                                    Gaya Pola
                                </label>
                                <div class="grid grid-cols-1 gap-2">
                                    <button
                                        type="button"
                                        id="btn-pattern-vertical"
                                        class="w-full py-2 rounded-xl text-xs font-medium bg-brand-500 text-dark-950 transition"
                                    >
                                        Vertikal
                                    </button>
                                    <button
                                        type="button"
                                        id="btn-pattern-horizontal"
                                        class="w-full py-2 rounded-xl text-xs font-medium bg-white/5 text-white/70 hover:bg-white/10 transition"
                                    >
                                        Horizontal (Tackle)
                                    </button>
                                </div>
                            </div>
                            <div class="flex items-center justify-between">
                                <label class="text-sm text-white/60">
                                    Warna Garis
                                </label>
                                <input
                                    type="color"
                                    id="color-stripe"
                                    value="#ffffff"
                                />
                            </div>
                            <div>
                                <div class="flex justify-between text-sm text-white/60 mb-1">
                                    <span>Jumlah Garis</span>
                                    <span id="stripe-count-label">2</span>
                                </div>
                                <input
                                    type="range"
                                    id="stripe-count"
                                    min="0"
                                    max="6"
                                    value="2"
                                    class="editor-slider w-full"
                                />
                            </div>
                            <div>
                                <div class="flex justify-between text-sm text-white/60 mb-1">
                                    <span>Lebar Garis</span>
                                    <span id="stripe-width-label">8%</span>
                                </div>
                                <input
                                    type="range"
                                    id="stripe-width"
                                    min="2"
                                    max="20"
                                    value="8"
                                    class="editor-slider w-full"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="bg-dark-800/70 border border-white/5 rounded-2xl p-5 flex flex-col">
                        <h3 class="font-display font-semibold text-sm mb-3 text-white/80">
                            Logo & Teks
                        </h3>
                        <div class="space-y-3 flex-1">
                            <label class="flex flex-col items-center justify-center w-full h-20 border-2 border-dashed border-white/15 rounded-xl cursor-pointer hover:border-brand-500/40 transition">
                                <span class="text-sm text-white/50" id="logo-label">
                                    Upload Logo (PNG transparan)
                                </span>
                                <input
                                    type="file"
                                    id="logo-upload"
                                    accept="image/png,image/jpeg,image/webp"
                                    class="hidden"
                                />
                            </label>
                            <div>
                                <div class="flex justify-between text-sm text-white/60 mb-1">
                                    <span>Ukuran Logo</span>
                                    <span id="logo-size-label">18%</span>
                                </div>
                                <input
                                    type="range"
                                    id="logo-size"
                                    min="8"
                                    max="40"
                                    value="18"
                                    class="editor-slider w-full"
                                />
                            </div>
                            <div>
                                <div class="flex justify-between text-sm text-white/60 mb-1">
                                    <span>Rotasi Logo</span>
                                    <span id="logo-rotation-label">0°</span>
                                </div>
                                <input
                                    type="range"
                                    id="logo-rotation"
                                    min="0"
                                    max="360"
                                    value="0"
                                    class="editor-slider w-full"
                                />
                            </div>
                            <label class="flex items-center justify-between gap-3 cursor-pointer text-sm text-white/60">
                                <span>Mirror Logo</span>
                                <input
                                    type="checkbox"
                                    id="logo-mirror"
                                    class="accent-yellow-400 h-4 w-4"
                                />
                            </label>
                            <div>
                                <label class="text-xs text-white/40 block mb-1">
                                    Teks / Nama / Nomor
                                </label>
                                <input
                                    id="text-input"
                                    type="text"
                                    placeholder="Contoh: SURYLES 10"
                                    maxlength="24"
                                    class="w-full bg-dark-900/60 border border-white/10 rounded-lg px-3 py-2 text-sm text-white/90 focus:outline-none focus:border-brand-500/50"
                                />
                            </div>
                            <div class="flex items-center justify-between">
                                <label class="text-sm text-white/60">
                                    Warna Teks
                                </label>
                                <input
                                    type="color"
                                    id="text-color"
                                    value="#ffffff"
                                />
                            </div>
                            <div>
                                <div class="flex justify-between text-sm text-white/60 mb-1">
                                    <span>Ukuran Teks</span>
                                    <span id="text-size-label">12%</span>
                                </div>
                                <input
                                    type="range"
                                    id="text-size"
                                    min="4"
                                    max="30"
                                    value="12"
                                    class="editor-slider w-full"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <button
                        type="button"
                        id="btn-export"
                        class="flex-1 py-3 rounded-xl bg-brand-500 hover:bg-brand-400 text-dark-950 font-semibold text-sm transition btn-press shadow-lg shadow-brand-500/20"
                    >
                        Export PNG
                    </button>
                    <button
                        type="button"
                        id="btn-reset"
                        class="py-3 px-5 rounded-xl bg-white/5 hover:bg-white/10 text-white/80 font-medium text-sm transition btn-press"
                    >
                        Reset
                    </button>
                </div>
                <p class="text-xs text-white/40 text-center">
                    Export menghasilkan desain (texture) + preview 3D. Kirim ke
                    WhatsApp untuk produksi.
                </p>
            </div>

            <!-- 3D preview -->
            <div
                class:list={[
                    "reveal min-w-0",
                    fullPage
                        ? "editor-full-page-preview h-full min-h-0 p-3 sm:p-5 lg:p-8"
                        : "lg:col-span-3 order-1 lg:order-2",
                ]}
            >
                <div
                    class="relative bg-gradient-to-b from-dark-800/80 to-dark-900/80 border border-white/5 rounded-2xl overflow-hidden"
                    style={fullPage ? "height: 100%; min-height: 0;" : "min-height: 400px;"}
                >
                    <div
                        id="design-canvas-container"
                        class:list={[
                            "w-full h-[400px] sm:h-[460px] md:h-[540px] relative",
                            fullPage ? "editor-full-page-canvas h-full" : "",
                        ]}
                    >
                        <div
                            id="canvas-placeholder"
                            class="absolute inset-0 flex items-center justify-center z-10"
                        >
                            <div class="text-center">
                                <div class="w-12 h-12 mx-auto mb-3 border-2 border-brand-500/30 border-t-brand-400 rounded-full animate-spin"></div>
                                <p class="text-sm text-white/40">
                                    Memuat model 3D...
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="absolute bottom-3 left-0 right-0 text-center pointer-events-none">
                        <p
                            class="text-xs text-white/30 bg-dark-950/50 inline-block px-3 py-1 rounded-full"
                        >
                            Drag untuk putar · Scroll untuk zoom
                        </p>
                    </div>
                    <div
                        id="model-status"
                        class="absolute top-3 left-3 text-xs text-white/40 bg-dark-950/60 px-2 py-1 rounded-lg"
                    ></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script
    is:inline
    type="application/json"
    id="design-presets"
    set:html={JSON.stringify(designPresets)}
></script>

<!-- Three.js r128 + GLTFLoader -->
<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"
></script>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"
></script>
<script is:inline>
    (function () {
        function waitForLibs(cb, tries) {
            tries = tries || 0;
            if (
                typeof THREE !== "undefined" &&
                typeof THREE.GLTFLoader !== "undefined"
            ) {
                cb();
            } else if (tries < 80) {
                setTimeout(function () {
                    waitForLibs(cb, tries + 1);
                }, 50);
            } else {
                // Fallback without GLTFLoader name on THREE
                if (typeof THREE !== "undefined") cb();
                else console.error("Three.js failed to load");
            }
        }

        waitForLibs(initEditor);

        function initEditor() {
            var container = document.getElementById("design-canvas-container");
            var placeholder = document.getElementById("canvas-placeholder");
            var statusEl = document.getElementById("model-status");
            if (!container) return;

            var DESIGNS = [];
            try {
                var presetsEl = document.getElementById("design-presets");
                if (presetsEl) DESIGNS = JSON.parse(presetsEl.textContent) || [];
            } catch (e) {
                DESIGNS = [];
            }

            var brightness = 100;
            var zoneMasks = null;
            var ZONE_KEYS = ["front", "back", "sleeveLeft", "sleeveRight"];

            // Logo & text overlay (drawn straight onto the texture)
            var logoImg = null;
            var logoDataUrl = null;
            var logoSize = 18;
            var logoX = 256;
            var logoY = 560;
            var logoRotation = 0;
            var logoMirror = false;
            var textValue = "";
            var textColor = "#ffffff";
            var textSize = 12;

            function makeZoneState() {
                return {
                    pattern: "vertical-stripes",
                    colors: ["#fef013", "#ffffff"],
                    stripeCount: 2,
                    stripeWidth: 8,
                };
            }

            // Per-zone design state. "all" edits every zone at once; picking a
            // specific zone lets front/back/sleeves diverge.
            var zones = {
                front: makeZoneState(),
                back: makeZoneState(),
                sleeveLeft: makeZoneState(),
                sleeveRight: makeZoneState(),
            };
            var activeZone = "all";
            var activeDesignId = null;

            function targetZoneKeys() {
                return activeZone === "all" ? ZONE_KEYS : [activeZone];
            }

            function primaryTargetZone() {
                return zones[targetZoneKeys()[0]];
            }

            var width = container.clientWidth;
            var height = container.clientHeight;

            var scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0f172a);

            var camera = new THREE.PerspectiveCamera(
                35,
                width / height,
                0.1,
                100,
            );
            var isFullPageEditor =
                document.getElementById("design-editor")?.dataset.fullPage ===
                "true";
            camera.position.set(0, 0.15, isFullPageEditor ? 4.2 : 2.4);

            var renderer = new THREE.WebGLRenderer({
                antialias: true,
                preserveDrawingBuffer: true,
                alpha: true,
            });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            if (renderer.outputEncoding !== undefined)
                renderer.outputEncoding = THREE.sRGBEncoding;
            if (renderer.toneMapping !== undefined) {
                renderer.toneMapping = THREE.ACESFilmicToneMapping;
                renderer.toneMappingExposure = 1.1;
            }
            container.appendChild(renderer.domElement);

            // Lights - soft studio look
            scene.add(new THREE.AmbientLight(0xffffff, 0.55));
            var key = new THREE.DirectionalLight(0xffffff, 1.0);
            key.position.set(2.5, 4, 3);
            scene.add(key);
            var fill = new THREE.DirectionalLight(0xfff3b0, 0.35);
            fill.position.set(-3, 1.5, -1);
            scene.add(fill);
            var rim = new THREE.DirectionalLight(0xffffff, 0.25);
            rim.position.set(0, 2, -3);
            scene.add(rim);

            // Design texture
            var texCanvas = document.createElement("canvas");
            texCanvas.width = 1024;
            texCanvas.height = 1024;
            var texCtx = texCanvas.getContext("2d");
            var designTexture = new THREE.CanvasTexture(texCanvas);
            designTexture.needsUpdate = true;
            if (designTexture.encoding !== undefined)
                designTexture.encoding = THREE.sRGBEncoding;

            // Pattern canvas: the procedurally generated background layer
            var patternCanvas = document.createElement("canvas");
            patternCanvas.width = 1024;
            patternCanvas.height = 1024;
            var patternCtx = patternCanvas.getContext("2d");

            var frontMaskCanvas = document.createElement("canvas");
            frontMaskCanvas.width = 1024;
            frontMaskCanvas.height = 1024;
            var frontMaskCtx = frontMaskCanvas.getContext("2d");
            var overlayCanvas = document.createElement("canvas");
            overlayCanvas.width = 1024;
            overlayCanvas.height = 1024;
            var overlayCtx = overlayCanvas.getContext("2d");

            // Reusable staging canvas for per-zone masked compositing
            var stageCanvas = document.createElement("canvas");
            stageCanvas.width = 1024;
            stageCanvas.height = 1024;
            var stageCtx = stageCanvas.getContext("2d");

            // Classify a vertex/triangle centroid into a garment zone.
            function classifyVertex(x, y, z) {
                if (x < -0.17) return "sleeveLeft";
                if (x > 0.17) return "sleeveRight";
                if (z > 0.02) return "front";
                if (z < -0.02) return "back";
                return null;
            }

            // Parse shirt_baked.glb geometry and rasterize a white UV mask per
            // zone (front/back/sleeves). This drives accurate per-area designs.
            function buildZoneMasks(arrayBuffer) {
                try {
                    var view = new DataView(arrayBuffer);
                    var magic = new Uint8Array(arrayBuffer, 0, 4);
                    if (magic[0] !== 0x67 || magic[1] !== 0x6c) return null;
                    var total = view.getUint32(8, true);
                    var off = 12;
                    var json = null;
                    var binOffset = 0;
                    while (off < total) {
                        var clen = view.getUint32(off, true);
                        var ctype = view.getUint32(off + 4, true);
                        if (ctype === 0x4e4f534a) {
                            json = JSON.parse(
                                new TextDecoder().decode(
                                    new Uint8Array(
                                        arrayBuffer,
                                        off + 8,
                                        clen,
                                    ),
                                ),
                            );
                        } else if (ctype === 0x004e4942) {
                            binOffset = off + 8;
                        }
                        off += 8 + clen;
                    }
                    if (!json) return null;
                    var g = json;
                    var prim = g.meshes[0].primitives[0];

                    function readAccessor(ai) {
                        var a = g.accessors[ai];
                        var bv = g.bufferViews[a.bufferView];
                        var start =
                            binOffset +
                            (bv.byteOffset || 0) +
                            (a.byteOffset || 0);
                        var compBytes = {
                            5120: 1,
                            5121: 1,
                            5122: 2,
                            5123: 2,
                            5125: 4,
                            5126: 4,
                        }[a.componentType];
                        var nComp = { SCALAR: 1, VEC2: 2, VEC3: 3, VEC4: 4 }[
                            a.type
                        ];
                        var stride = bv.byteStride || compBytes * nComp;
                        var res = [];
                        for (var i = 0; i < a.count; i++) {
                            var rec = [];
                            for (var c = 0; c < nComp; c++) {
                                var p = start + i * stride + c * compBytes;
                                if (a.componentType === 5126)
                                    rec.push(view.getFloat32(p, true));
                                else if (a.componentType === 5125)
                                    rec.push(view.getUint32(p, true));
                                else if (a.componentType === 5123)
                                    rec.push(view.getUint16(p, true));
                                else rec.push(view.getUint8(p));
                            }
                            res.push(rec);
                        }
                        return res;
                    }

                    var pos = readAccessor(prim.attributes.POSITION);
                    var uvs = readAccessor(prim.attributes.TEXCOORD_0);
                    var idx = readAccessor(prim.indices);

                    var masks = {};
                    var mctx = {};
                    ZONE_KEYS.forEach(function (k) {
                        var cv = document.createElement("canvas");
                        cv.width = 1024;
                        cv.height = 1024;
                        var cx = cv.getContext("2d");
                        cx.fillStyle = "#ffffff";
                        cx.strokeStyle = "#ffffff";
                        cx.lineWidth = 2;
                        masks[k] = cv;
                        mctx[k] = cx;
                    });

                    for (var t = 0; t < idx.length; t += 3) {
                        var ia = idx[t][0];
                        var ib = idx[t + 1][0];
                        var ic = idx[t + 2][0];
                        var pa = pos[ia];
                        var pb = pos[ib];
                        var pc = pos[ic];
                        var zk = classifyVertex(
                            (pa[0] + pb[0] + pc[0]) / 3,
                            (pa[1] + pb[1] + pc[1]) / 3,
                            (pa[2] + pb[2] + pc[2]) / 3,
                        );
                        if (!zk) continue;
                        var ctx2 = mctx[zk];
                        var ua = uvs[ia];
                        var ub = uvs[ib];
                        var uc = uvs[ic];
                        ctx2.beginPath();
                        ctx2.moveTo(ua[0] * 1024, (1 - ua[1]) * 1024);
                        ctx2.lineTo(ub[0] * 1024, (1 - ub[1]) * 1024);
                        ctx2.lineTo(uc[0] * 1024, (1 - uc[1]) * 1024);
                        ctx2.closePath();
                        ctx2.fill();
                        ctx2.stroke();
                        if (zk === "front") {
                            frontMaskCtx.beginPath();
                            frontMaskCtx.moveTo(
                                ua[0] * 1024,
                                (1 - ua[1]) * 1024,
                            );
                            frontMaskCtx.lineTo(
                                ub[0] * 1024,
                                (1 - ub[1]) * 1024,
                            );
                            frontMaskCtx.lineTo(
                                uc[0] * 1024,
                                (1 - uc[1]) * 1024,
                            );
                            frontMaskCtx.closePath();
                            frontMaskCtx.fill();
                            frontMaskCtx.stroke();
                        }
                    }
                    return masks;
                } catch (e) {
                    console.warn("Zone mask build failed", e);
                    return null;
                }
            }

            fetch("/models/shirt_baked.glb")
                .then(function (r) {
                    return r.arrayBuffer();
                })
                .then(function (ab) {
                    zoneMasks = buildZoneMasks(ab);
                    if (zoneMasks) drawTexture();
                })
                .catch(function () {});

            var meshGroup = new THREE.Group();
            scene.add(meshGroup);

            var gltfShirt = null; // loaded model root
            var shirtMesh = null; // main mesh with material
            var useGltf = false;

            function setStatus(msg) {
                if (statusEl) statusEl.textContent = msg || "";
            }

            function clearGroup() {
                while (meshGroup.children.length) {
                    var c = meshGroup.children[0];
                    meshGroup.remove(c);
                }
            }

            function setGroupTransform(scale, posY) {
                meshGroup.scale.setScalar(scale);
                meshGroup.position.set(0, posY, 0);
            }

            function applyMaterialToObject(obj) {
                obj.traverse(function (child) {
                    if (child.isMesh) {
                        // Prefer replacing material so our canvas texture shows
                        var mat = new THREE.MeshStandardMaterial({
                            map: designTexture,
                            roughness: 0.65,
                            metalness: 0.05,
                            side: THREE.DoubleSide,
                        });
                        child.material = mat;
                        child.castShadow = true;
                        child.receiveShadow = true;
                        if (!shirtMesh) shirtMesh = child;
                    }
                });
            }

            function buildProceduralJersey() {
                clearGroup();
                shirtMesh = null;
                useGltf = false;
                setStatus("Procedural mesh");

                var mat = new THREE.MeshStandardMaterial({
                    map: designTexture,
                    roughness: 0.6,
                    metalness: 0.04,
                    side: THREE.DoubleSide,
                });

                // More organic torso using lathe-like approximation via scaled box + sleeves
                var torso = new THREE.Mesh(
                    new THREE.BoxGeometry(1.35, 1.55, 0.32, 8, 8, 2),
                    mat,
                );
                torso.position.y = 0.05;
                // slight shoulder widen via scale on upper - approximate with second layer
                meshGroup.add(torso);

                var shoulder = new THREE.Mesh(
                    new THREE.BoxGeometry(1.55, 0.35, 0.34, 6, 2, 2),
                    mat,
                );
                shoulder.position.y = 0.65;
                meshGroup.add(shoulder);

                var sleeveGeo = new THREE.CylinderGeometry(0.16, 0.2, 0.65, 20);
                var leftS = new THREE.Mesh(sleeveGeo, mat);
                leftS.rotation.z = Math.PI / 2.15;
                leftS.position.set(-0.95, 0.55, 0);
                meshGroup.add(leftS);

                var rightS = new THREE.Mesh(sleeveGeo.clone(), mat);
                rightS.rotation.z = -Math.PI / 2.15;
                rightS.position.set(0.95, 0.55, 0);
                meshGroup.add(rightS);

                var collar = new THREE.Mesh(
                    new THREE.TorusGeometry(0.26, 0.055, 10, 28, Math.PI),
                    new THREE.MeshStandardMaterial({
                        color: 0x1e293b,
                        roughness: 0.55,
                    }),
                );
                collar.rotation.x = Math.PI / 2;
                collar.position.set(0, 0.82, 0.06);
                meshGroup.add(collar);

                setGroupTransform(0.95, -0.15);
            }

            function loadGltfShirt() {
                setStatus("Loading GLTF...");
                var loader = null;
                if (typeof THREE.GLTFLoader === "function") {
                    loader = new THREE.GLTFLoader();
                } else if (typeof GLTFLoader === "function") {
                    loader = new GLTFLoader();
                }

                if (!loader) {
                    console.warn("GLTFLoader not available, using procedural");
                    buildProceduralJersey();
                    if (placeholder) placeholder.style.display = "none";
                    return;
                }

                loader.load(
                    "/models/shirt_baked.glb",
                    function (gltf) {
                        clearGroup();
                        setGroupTransform(1, 0);
                        gltfShirt = gltf.scene;
                        // Center and scale
                        var box = new THREE.Box3().setFromObject(gltfShirt);
                        var size = box.getSize(new THREE.Vector3());
                        var center = box.getCenter(new THREE.Vector3());
                        var maxDim = Math.max(size.x, size.y, size.z);
                        var scale = 1.8 / maxDim;
                        gltfShirt.scale.setScalar(scale);
                        gltfShirt.position.sub(center.multiplyScalar(scale));
                        gltfShirt.position.y -= 0.1;

                        applyMaterialToObject(gltfShirt);
                        meshGroup.add(gltfShirt);
                        useGltf = true;
                        setStatus("GLTF · shirt_baked");
                        if (placeholder) placeholder.style.display = "none";
                        drawTexture();
                    },
                    undefined,
                    function (err) {
                        console.warn(
                            "GLTF load failed, fallback procedural",
                            err,
                        );
                        buildProceduralJersey();
                        if (placeholder) placeholder.style.display = "none";
                        drawTexture();
                    },
                );
            }

            function renderPattern(ctx, w, h, d) {
                var colors = (d && d.colors) || ["#ffffff", "#111827"];
                var primary = colors[0] || "#ffffff";
                var secondary = colors[1] || primary;
                var p = (d && d.pattern) || "solid";
                var count =
                    d && d.stripeCount != null ? d.stripeCount : 3;
                var widthPct =
                    d && d.stripeWidth != null ? d.stripeWidth : 10;

                ctx.clearRect(0, 0, w, h);
                ctx.fillStyle = primary;
                ctx.fillRect(0, 0, w, h);

                if (p === "gradient") {
                    var grad = ctx.createLinearGradient(0, 0, 0, h);
                    grad.addColorStop(0, primary);
                    grad.addColorStop(1, secondary);
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, 0, w, h);
                    return;
                }

                ctx.fillStyle = secondary;

                if (p === "vertical-stripes") {
                    var vGap = w / (count + 1);
                    var vBar = (widthPct / 100) * w;
                    for (var vi = 1; vi <= count; vi++) {
                        ctx.fillRect(vGap * vi - vBar / 2, 0, vBar, h);
                    }
                } else if (p === "hoops") {
                    var bands = count * 2 + 1;
                    var bandH = h / bands;
                    for (var bi = 1; bi < bands; bi += 2) {
                        ctx.fillRect(0, bandH * bi, w, bandH);
                    }
                } else if (p === "pinstripes") {
                    var pn = count * 3 + 4;
                    var pStep = w / pn;
                    var pLine = Math.max(2, (widthPct / 100) * w * 0.3);
                    for (var pi = 0; pi < pn; pi++) {
                        if (pi % 2 === 0) {
                            ctx.fillRect(pi * pStep, 0, pLine, h);
                        }
                    }
                } else if (p === "diagonal") {
                    var dBar = Math.max((widthPct / 100) * w, w * 0.08);
                    var period = dBar * 2;
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(0, 0, w, h);
                    ctx.clip();
                    for (var dx = -h; dx < w + h; dx += period) {
                        ctx.beginPath();
                        ctx.moveTo(dx, h);
                        ctx.lineTo(dx + dBar, h);
                        ctx.lineTo(dx + dBar + h, 0);
                        ctx.lineTo(dx + h, 0);
                        ctx.closePath();
                        ctx.fill();
                    }
                    ctx.restore();
                } else if (p === "sash") {
                    ctx.save();
                    ctx.strokeStyle = secondary;
                    ctx.lineWidth = Math.max((widthPct / 100) * w, w * 0.1);
                    ctx.beginPath();
                    ctx.moveTo(-w * 0.1, h * 0.3);
                    ctx.lineTo(w * 1.1, h * 0.7);
                    ctx.stroke();
                    ctx.restore();
                } else if (p === "halves") {
                    ctx.fillRect(w / 2, 0, w / 2, h);
                } else if (p === "yoke") {
                    ctx.fillRect(0, 0, w, h * 0.28);
                } else if (p === "checker") {
                    var cn = count + 2;
                    var cell = w / cn;
                    for (var cy = 0; cy < cn; cy++) {
                        for (var cx = 0; cx < cn; cx++) {
                            if ((cx + cy) % 2 === 0) {
                                ctx.fillRect(cx * cell, cy * cell, cell, cell);
                            }
                        }
                    }
                } else if (p === "side-panels") {
                    ctx.fillRect(0, 0, w * 0.14, h);
                    ctx.fillRect(w * 0.86, 0, w * 0.14, h);
                } else if (p === "center-block") {
                    ctx.fillRect(w * 0.26, h * 0.16, w * 0.48, h * 0.52);
                } else if (p === "v-sash") {
                    ctx.save();
                    ctx.lineWidth = Math.max((widthPct / 100) * w, w * 0.12);
                    ctx.lineCap = "butt";
                    ctx.beginPath();
                    ctx.moveTo(w * 0.08, 0);
                    ctx.lineTo(w * 0.5, h * 0.43);
                    ctx.lineTo(w * 0.92, 0);
                    ctx.strokeStyle = secondary;
                    ctx.stroke();
                    ctx.restore();
                } else if (p === "yoke-stripes") {
                    var yokeH = h * 0.34;
                    ctx.fillRect(0, 0, w, yokeH);
                    ctx.fillStyle = primary;
                    for (var ys = 1; ys <= count; ys++) {
                        ctx.fillRect(0, (yokeH / (count + 1)) * ys, w, 2);
                    }
                } else if (p === "double-sash") {
                    ctx.save();
                    ctx.strokeStyle = secondary;
                    ctx.lineWidth = Math.max((widthPct / 100) * w, w * 0.08);
                    ctx.beginPath();
                    ctx.moveTo(w * 0.04, 0);
                    ctx.lineTo(w * 0.48, h * 0.56);
                    ctx.moveTo(w * 0.28, 0);
                    ctx.lineTo(w * 0.72, h * 0.56);
                    ctx.stroke();
                    ctx.restore();
                } else if (p === "shoulder-panels") {
                    ctx.beginPath();
                    ctx.moveTo(0, 0);
                    ctx.lineTo(w * 0.28, 0);
                    ctx.lineTo(w * 0.5, h * 0.18);
                    ctx.lineTo(w * 0.72, 0);
                    ctx.lineTo(w, 0);
                    ctx.lineTo(w, h * 0.28);
                    ctx.lineTo(w * 0.67, h * 0.2);
                    ctx.lineTo(w * 0.5, h * 0.3);
                    ctx.lineTo(w * 0.33, h * 0.2);
                    ctx.lineTo(0, h * 0.28);
                    ctx.closePath();
                    ctx.fill();
                } else if (p === "chest-band") {
                    ctx.fillRect(0, h * 0.22, w, h * 0.28);
                    ctx.fillStyle = primary;
                    ctx.fillRect(0, h * 0.22, w, h * 0.025);
                    ctx.fillRect(0, h * 0.475, w, h * 0.025);
                } else if (p === "gradient-hem") {
                    var hem = ctx.createLinearGradient(0, h * 0.5, 0, h);
                    hem.addColorStop(0, primary);
                    hem.addColorStop(0.5, secondary);
                    hem.addColorStop(1, secondary);
                    ctx.fillStyle = hem;
                    ctx.fillRect(0, h * 0.5, w, h * 0.5);
                    ctx.fillStyle = primary;
                    ctx.beginPath();
                    ctx.moveTo(0, h * 0.58);
                    for (var fx = 0; fx <= 12; fx++) {
                        var px = (w / 12) * fx;
                        var py = h * (fx % 2 === 0 ? 0.58 : 0.49);
                        ctx.lineTo(px, py);
                    }
                    ctx.lineTo(w, h * 0.66);
                    ctx.lineTo(0, h * 0.66);
                    ctx.closePath();
                    ctx.fill();
                } else if (p === "lightning") {
                    ctx.beginPath();
                    ctx.moveTo(w * 0.58, 0);
                    ctx.lineTo(w * 0.25, h * 0.48);
                    ctx.lineTo(w * 0.47, h * 0.48);
                    ctx.lineTo(w * 0.3, h);
                    ctx.lineTo(w * 0.78, h * 0.39);
                    ctx.lineTo(w * 0.55, h * 0.39);
                    ctx.closePath();
                    ctx.fill();
                }
            }

            // Front panel centre in UV/texture space (see zone masks)
            var FRONT_CX = 256;
            var textY = 640;

            function syncTexture() {
                texCtx.clearRect(0, 0, 1024, 1024);
                texCtx.drawImage(patternCanvas, 0, 0, 1024, 1024);

                // Logo overlay (front chest)
                if (logoImg) {
                    var logoW = (logoSize / 100) * 1024;
                    var logoH =
                        logoW * (logoImg.height / Math.max(1, logoImg.width));
                    overlayCtx.clearRect(0, 0, 1024, 1024);
                    overlayCtx.save();
                    overlayCtx.translate(logoX, logoY);
                    overlayCtx.rotate((logoRotation * Math.PI) / 180);
                    overlayCtx.scale(logoMirror ? -1 : 1, 1);
                    overlayCtx.drawImage(
                        logoImg,
                        -logoW / 2,
                        -logoH / 2,
                        logoW,
                        logoH,
                    );
                    overlayCtx.restore();
                    overlayCtx.globalCompositeOperation = "destination-in";
                    overlayCtx.drawImage(frontMaskCanvas, 0, 0, 1024, 1024);
                    overlayCtx.globalCompositeOperation = "source-over";
                    texCtx.drawImage(overlayCanvas, 0, 0, 1024, 1024);
                }

                // Text overlay (name / number)
                if (textValue) {
                    var fs = (textSize / 100) * 1024;
                    overlayCtx.clearRect(0, 0, 1024, 1024);
                    overlayCtx.font =
                        "700 " +
                        Math.round(fs) +
                        'px Outfit, "Inter", sans-serif';
                    overlayCtx.textAlign = "center";
                    overlayCtx.textBaseline = "middle";
                    overlayCtx.lineWidth = Math.max(2, fs * 0.06);
                    overlayCtx.strokeStyle = "rgba(0,0,0,0.45)";
                    overlayCtx.fillStyle = textColor;
                    overlayCtx.save();
                    overlayCtx.translate(FRONT_CX, textY);
                    overlayCtx.scale(1, -1);
                    overlayCtx.strokeText(textValue, 0, 0);
                    overlayCtx.fillText(textValue, 0, 0);
                    overlayCtx.restore();
                    overlayCtx.globalCompositeOperation = "destination-in";
                    overlayCtx.drawImage(frontMaskCanvas, 0, 0, 1024, 1024);
                    overlayCtx.globalCompositeOperation = "source-over";
                    texCtx.drawImage(overlayCanvas, 0, 0, 1024, 1024);
                }

                designTexture.needsUpdate = true;

                // Update materials on current meshes
                meshGroup.traverse(function (child) {
                    if (
                        child.isMesh &&
                        child.material &&
                        child.material.map === designTexture
                    ) {
                        child.material.needsUpdate = true;
                    }
                });

            }

            function patternSpec(z) {
                return {
                    pattern: z.pattern,
                    colors: z.colors,
                    stripeCount: z.stripeCount,
                    stripeWidth: z.stripeWidth,
                };
            }

            function drawTexture() {
                // Fallback fill (covers seams / texels outside every zone)
                patternCtx.fillStyle = zones.front.colors[0] || "#fef013";
                patternCtx.fillRect(0, 0, 1024, 1024);

                if (zoneMasks) {
                    // Composite each zone's pattern through its UV mask
                    ZONE_KEYS.forEach(function (k) {
                        renderPattern(
                            stageCtx,
                            1024,
                            1024,
                            patternSpec(zones[k]),
                        );
                        stageCtx.globalCompositeOperation = "destination-in";
                        stageCtx.drawImage(zoneMasks[k], 0, 0, 1024, 1024);
                        stageCtx.globalCompositeOperation = "source-over";
                        patternCtx.drawImage(stageCanvas, 0, 0, 1024, 1024);
                    });
                } else {
                    // Masks not ready yet: render a single global pattern
                    renderPattern(
                        patternCtx,
                        1024,
                        1024,
                        patternSpec(primaryTargetZone()),
                    );
                }

                if (brightness < 100) {
                    patternCtx.fillStyle =
                        "rgba(0,0,0," + (1 - brightness / 100) + ")";
                    patternCtx.fillRect(0, 0, 1024, 1024);
                }

                syncTexture();
            }

            // Start with GLTF for jersey
            loadGltfShirt();

            // Orbit
            var isDragging = false;
            var dragOverlay = null;
            var prevX = 0,
                prevY = 0;
            var rotY = 0.35,
                rotX = 0.12;

            var overlayRaycaster = new THREE.Raycaster();
            var overlayPointer = new THREE.Vector2();
            var textureUv = new THREE.Vector2();

            function findFrontPositionAtTexture(textureX, textureY) {
                if (!shirtMesh || !shirtMesh.geometry) return null;
                var geometry = shirtMesh.geometry;
                var positions = geometry.attributes.position;
                var uvs = geometry.attributes.uv;
                if (!positions || !uvs) return null;

                var indices = geometry.index;
                var vertexCount = indices ? indices.count : positions.count;
                textureUv.set(textureX / 1024, 1 - textureY / 1024);

                for (var ti = 0; ti < vertexCount; ti += 3) {
                    var ia = indices ? indices.getX(ti) : ti;
                    var ib = indices ? indices.getX(ti + 1) : ti + 1;
                    var ic = indices ? indices.getX(ti + 2) : ti + 2;
                    var ax = uvs.getX(ia), ay = uvs.getY(ia);
                    var bx = uvs.getX(ib), by = uvs.getY(ib);
                    var cx = uvs.getX(ic), cy = uvs.getY(ic);
                    var denominator = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy);
                    if (Math.abs(denominator) < 1e-8) continue;

                    var a =
                        ((by - cy) * (textureUv.x - cx) +
                            (cx - bx) * (textureUv.y - cy)) /
                        denominator;
                    var b =
                        ((cy - ay) * (textureUv.x - cx) +
                            (ax - cx) * (textureUv.y - cy)) /
                        denominator;
                    var c = 1 - a - b;
                    if (a < -0.001 || b < -0.001 || c < -0.001) continue;

                    var px =
                        a * positions.getX(ia) +
                        b * positions.getX(ib) +
                        c * positions.getX(ic);
                    var py =
                        a * positions.getY(ia) +
                        b * positions.getY(ib) +
                        c * positions.getY(ic);
                    var pz =
                        a * positions.getZ(ia) +
                        b * positions.getZ(ib) +
                        c * positions.getZ(ic);
                    if (pz < 0.02 || Math.abs(px) > 0.17) continue;
                    return new THREE.Vector3(px, py, pz);
                }
                return null;
            }

            function getOverlayScreenPoint(kind) {
                var textureX = FRONT_CX;
                var textureY = textY;
                if (kind === "logo") {
                    textureX = logoX;
                    textureY = logoY;
                }
                var localPoint = findFrontPositionAtTexture(textureX, textureY);
                if (!localPoint) return null;
                meshGroup.updateMatrixWorld(true);
                camera.updateMatrixWorld(true);
                var worldPoint = shirtMesh.localToWorld(localPoint);
                var projected = worldPoint.project(camera);
                var rect = renderer.domElement.getBoundingClientRect();
                return {
                    x: rect.left + ((projected.x + 1) / 2) * rect.width,
                    y: rect.top + ((1 - projected.y) / 2) * rect.height,
                };
            }

            function getEventPoint(e) {
                var point = e.touches && e.touches.length ? e.touches[0] : e;
                return { x: point.clientX, y: point.clientY };
            }

            function projectPointerToFrontTexture(e) {
                if (!shirtMesh || !useGltf) return null;
                var point = getEventPoint(e);
                var rect = renderer.domElement.getBoundingClientRect();
                if (!rect.width || !rect.height) return null;

                overlayPointer.x = ((point.x - rect.left) / rect.width) * 2 - 1;
                overlayPointer.y = -((point.y - rect.top) / rect.height) * 2 + 1;
                overlayRaycaster.setFromCamera(overlayPointer, camera);

                var hits = overlayRaycaster.intersectObject(shirtMesh, false);
                for (var hi = 0; hi < hits.length; hi++) {
                    var hit = hits[hi];
                    var localHit = hit.object.worldToLocal(hit.point.clone());
                    if (localHit.z < 0.02 || !hit.uv) continue;
                    var texturePoint = new THREE.Vector2(
                        hit.uv.x * 1024,
                        (1 - hit.uv.y) * 1024,
                    );
                    if (texturePoint.x < 40 || texturePoint.x > 470) continue;
                    return texturePoint;
                }
                return null;
            }

            function overlayHit(point) {
                if (!point) return null;
                if (textValue) {
                    texCtx.save();
                    var fs = (textSize / 100) * 1024;
                    texCtx.font =
                        "700 " +
                        Math.round(fs) +
                        'px Outfit, "Inter", sans-serif';
                    var textW = texCtx.measureText(textValue).width;
                    texCtx.restore();
                    if (
                        Math.abs(point.x - FRONT_CX) < Math.max(textW / 2, 35) &&
                        Math.abs(point.y - textY) < Math.max(fs / 2, 35)
                    ) {
                        return "text";
                    }
                }
                if (logoImg) {
                    var logoW = (logoSize / 100) * 1024;
                    var logoH =
                        logoW * (logoImg.height / Math.max(1, logoImg.width));
                    var logoCenterX = logoX;
                    var logoCenterY = logoY;
                    var dx = point.x - logoCenterX;
                    var dy = point.y - logoCenterY;
                    var angle = (logoRotation * Math.PI) / 180;
                    var localX = dx * Math.cos(angle) + dy * Math.sin(angle);
                    var localY = -dx * Math.sin(angle) + dy * Math.cos(angle);
                    if (
                        Math.abs(localX) < Math.max(logoW / 2, 35) &&
                        Math.abs(localY) < Math.max(logoH / 2, 35)
                    ) {
                        return "logo";
                    }
                }
                return null;
            }

            function ptrDown(e) {
                var point = getEventPoint(e);
                var texturePoint = projectPointerToFrontTexture(e);
                dragOverlay = overlayHit(texturePoint);
                isDragging = !dragOverlay;
                prevX = point.x;
                prevY = point.y;
                if (dragOverlay) {
                    e.preventDefault();
                    renderer.domElement.style.cursor = "move";
                }
            }
            function ptrMove(e) {
                var point = getEventPoint(e);
                if (dragOverlay) {
                    e.preventDefault();
                    var texturePoint = projectPointerToFrontTexture(e);
                    if (!texturePoint) return;
                    if (dragOverlay === "logo") {
                        logoX = Math.max(70, Math.min(440, texturePoint.x));
                        logoY = Math.max(270, Math.min(930, texturePoint.y));
                } else {
                    var textWidth = texCtx.measureText(textValue).width;
                    FRONT_CX = Math.max(
                        70 + textWidth / 2,
                        Math.min(440 - textWidth / 2, texturePoint.x),
                    );
                    textY = Math.max(250, Math.min(900, texturePoint.y));
                    if (textInput) textInput.dataset.hasPlacement = "true";
                }
                    syncTexture();
                    return;
                }
                if (!isDragging) return;
                rotY += (point.x - prevX) * 0.008;
                rotX += (point.y - prevY) * 0.006;
                rotX = Math.max(-0.55, Math.min(0.55, rotX));
                prevX = point.x;
                prevY = point.y;
            }
            function ptrUp() {
                isDragging = false;
                dragOverlay = null;
                renderer.domElement.style.cursor = "grab";
            }

            renderer.domElement.style.cursor = "grab";
            renderer.domElement.addEventListener("mousedown", ptrDown);
            renderer.domElement.addEventListener("mousemove", ptrMove);
            renderer.domElement.addEventListener("mouseup", ptrUp);
            renderer.domElement.addEventListener("mouseleave", ptrUp);
            renderer.domElement.addEventListener("touchstart", ptrDown, {
                passive: true,
            });
            renderer.domElement.addEventListener("touchmove", ptrMove, {
                passive: false,
            });
            renderer.domElement.addEventListener("touchend", ptrUp);
            renderer.domElement.addEventListener(
                "wheel",
                function (e) {
                    e.preventDefault();
                    camera.position.z = Math.max(
                        1.4,
                        Math.min(4.5, camera.position.z + e.deltaY * 0.0015),
                    );
                },
                { passive: false },
            );

            function animate() {
                requestAnimationFrame(animate);
                meshGroup.rotation.y = rotY;
                meshGroup.rotation.x = rotX;
                renderer.render(scene, camera);
            }
            animate();

            function resizeCanvas() {
                var w = container.clientWidth;
                var h = container.clientHeight;
                if (!w || !h) return;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
            }

            window.addEventListener("resize", resizeCanvas);
            // Also react to container size changes (responsive reflow, orientation change, etc.)
            if (typeof ResizeObserver !== "undefined") {
                new ResizeObserver(resizeCanvas).observe(container);
            }

            // UI
            var colorBase = document.getElementById("color-base");
            var colorStripe = document.getElementById("color-stripe");
            var stripeCountEl = document.getElementById("stripe-count");
            var stripeWidthEl = document.getElementById("stripe-width");
            var brightnessEl = document.getElementById("brightness");
            var logoUpload = document.getElementById("logo-upload");
            var logoLabel = document.getElementById("logo-label");
            var logoSizeEl = document.getElementById("logo-size");
            var logoRotationEl = document.getElementById("logo-rotation");
            var logoMirrorEl = document.getElementById("logo-mirror");
            var textInput = document.getElementById("text-input");
            var textColorEl = document.getElementById("text-color");
            var textSizeEl = document.getElementById("text-size");

            function setBaseColor(value) {
                targetZoneKeys().forEach(function (k) {
                    zones[k].colors[0] = value;
                });
                drawTexture();
            }
            function setAccentColor(value) {
                targetZoneKeys().forEach(function (k) {
                    zones[k].colors[1] = value;
                });
                drawTexture();
            }
            function setStripeCount(value) {
                targetZoneKeys().forEach(function (k) {
                    zones[k].stripeCount = value;
                });
                document.getElementById("stripe-count-label").textContent =
                    value;
                drawTexture();
            }
            function setStripeWidth(value) {
                targetZoneKeys().forEach(function (k) {
                    zones[k].stripeWidth = value;
                });
                document.getElementById("stripe-width-label").textContent =
                    value + "%";
                drawTexture();
            }

            colorBase.addEventListener("input", function (e) {
                setBaseColor(e.target.value);
            });
            colorStripe.addEventListener("input", function (e) {
                setAccentColor(e.target.value);
            });
            stripeCountEl.addEventListener("input", function (e) {
                setStripeCount(+e.target.value);
            });
            stripeWidthEl.addEventListener("input", function (e) {
                setStripeWidth(+e.target.value);
            });
            brightnessEl.addEventListener("input", function (e) {
                brightness = +e.target.value;
                drawTexture();
            });

            logoUpload.addEventListener("change", function (e) {
                var file = e.target.files[0];
                if (!file) return;
                logoLabel.textContent =
                    file.name.length > 22
                        ? file.name.slice(0, 20) + "…"
                        : file.name;
                var reader = new FileReader();
                reader.onload = function (ev) {
                    var img = new Image();
                    img.onload = function () {
                        logoImg = img;
                        logoDataUrl = ev.target.result;
                        syncTexture();
                    };
                    img.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            });

            if (logoSizeEl)
                logoSizeEl.addEventListener("input", function (e) {
                    logoSize = +e.target.value;
                    document.getElementById("logo-size-label").textContent =
                        logoSize + "%";
                    syncTexture();
                });
            if (logoRotationEl)
                logoRotationEl.addEventListener("input", function (e) {
                    logoRotation = +e.target.value;
                    document.getElementById(
                        "logo-rotation-label",
                    ).textContent = Math.round(logoRotation) + "°";
                    syncTexture();
                });
            if (logoMirrorEl)
                logoMirrorEl.addEventListener("change", function (e) {
                    logoMirror = e.target.checked;
                    syncTexture();
                });

            if (textInput)
                textInput.addEventListener("input", function (e) {
                    textValue = e.target.value;
                    syncTexture();
                });
            if (textColorEl)
                textColorEl.addEventListener("input", function (e) {
                    textColor = e.target.value;
                    syncTexture();
                });
            if (textSizeEl)
                textSizeEl.addEventListener("input", function (e) {
                    textSize = +e.target.value;
                    document.getElementById("text-size-label").textContent =
                        textSize + "%";
                    syncTexture();
                });

            document
                .querySelectorAll("#preset-colors button")
                .forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        setBaseColor(btn.dataset.color);
                        document
                            .querySelectorAll("#preset-colors button")
                            .forEach(function (b) {
                                b.classList.remove("border-white/30");
                                b.classList.add("border-transparent");
                            });
                        btn.classList.add("border-white/30");
                        btn.classList.remove("border-transparent");
                    });
                });

            function updatePatternButtons() {
                var base = "w-full py-2 rounded-xl text-xs font-medium transition ";
                var active = "bg-brand-500 text-dark-950";
                var idle = "bg-white/5 text-white/70 hover:bg-white/10";
                var z = primaryTargetZone();
                document.getElementById("btn-pattern-vertical").className =
                    base +
                    (z.pattern === "vertical-stripes" ? active : idle);
                document.getElementById("btn-pattern-horizontal").className =
                    base + (z.pattern === "hoops" ? active : idle);
            }

            function syncZoneControls() {
                var z = primaryTargetZone();
                colorBase.value = z.colors[0];
                colorStripe.value = z.colors[1];
                stripeCountEl.value = z.stripeCount;
                stripeWidthEl.value = z.stripeWidth;
                document.getElementById("stripe-count-label").textContent =
                    z.stripeCount;
                document.getElementById("stripe-width-label").textContent =
                    z.stripeWidth + "%";
                if (window.__syncColorPlate)
                    window.__syncColorPlate(z.colors[0]);
                updatePatternButtons();
            }

            function setActiveDesign(id) {
                activeDesignId = id;
                var nodes = document.querySelectorAll(
                    "#design-grid .design-swatch",
                );
                for (var si = 0; si < nodes.length; si++) {
                    var on = nodes[si].getAttribute("data-id") === id;
                    nodes[si].classList.toggle("border-brand-400", on);
                    nodes[si].classList.toggle("border-transparent", !on);
                }
            }

            function setPatternMode(mode) {
                var p = mode === "horizontal" ? "hoops" : "vertical-stripes";
                targetZoneKeys().forEach(function (k) {
                    zones[k].pattern = p;
                });
                setActiveDesign(null);
                updatePatternButtons();
                drawTexture();
            }

            function applyDesignToTargets(preset) {
                targetZoneKeys().forEach(function (k) {
                    zones[k].pattern = preset.pattern || "solid";
                    zones[k].colors = [
                        (preset.colors && preset.colors[0]) || "#fef013",
                        (preset.colors && preset.colors[1]) || "#ffffff",
                    ];
                    zones[k].stripeCount =
                        preset.stripeCount != null ? preset.stripeCount : 3;
                    zones[k].stripeWidth =
                        preset.stripeWidth != null ? preset.stripeWidth : 10;
                });
                syncZoneControls();
                setActiveDesign(preset.id);
                drawTexture();
            }

            // Zone selector (Semua / Depan / Belakang / Lengan L / Lengan R)
            var zoneSelector = document.getElementById("zone-selector");
            function setActiveZone(zone) {
                activeZone = zone;
                if (zoneSelector) {
                    var btns = zoneSelector.querySelectorAll("[data-zone]");
                    for (var zi = 0; zi < btns.length; zi++) {
                        var on = btns[zi].getAttribute("data-zone") === zone;
                        btns[zi].className =
                            "px-2.5 py-1 rounded-lg text-xs font-medium transition " +
                            (on
                                ? "bg-brand-500 text-dark-950"
                                : "bg-white/5 text-white/60 hover:bg-white/10");
                    }
                }
                setActiveDesign(null);
                syncZoneControls();
                drawTexture();
            }
            if (zoneSelector) {
                zoneSelector
                    .querySelectorAll("[data-zone]")
                    .forEach(function (b) {
                        b.addEventListener("click", function () {
                            setActiveZone(b.getAttribute("data-zone"));
                        });
                    });
            }

            document
                .getElementById("btn-pattern-vertical")
                .addEventListener("click", function () {
                    setPatternMode("vertical");
                });
            document
                .getElementById("btn-pattern-horizontal")
                .addEventListener("click", function () {
                    setPatternMode("horizontal");
                });

            // Build the design preset gallery
            var designGrid = document.getElementById("design-grid");
            if (designGrid) {
                DESIGNS.forEach(function (preset) {
                    var btn = document.createElement("button");
                    btn.type = "button";
                    btn.setAttribute("data-id", preset.id);
                    btn.title = preset.name;
                    btn.className =
                        "design-swatch relative aspect-square rounded-lg overflow-hidden border-2 border-transparent hover:border-white/40 transition";
                    var cv = document.createElement("canvas");
                    cv.width = 120;
                    cv.height = 120;
                    cv.className = "w-full h-full block";
                    renderPattern(cv.getContext("2d"), cv.width, cv.height, preset);
                    btn.appendChild(cv);
                    btn.addEventListener("click", function () {
                        applyDesignToTargets(preset);
                    });
                    designGrid.appendChild(btn);
                });
                var countEl = document.getElementById("design-count");
                if (countEl) countEl.textContent = DESIGNS.length + " desain";
            }

            if (DESIGNS.length) {
                applyDesignToTargets(DESIGNS[0]);
            } else {
                syncZoneControls();
                drawTexture();
            }

            function exportDesign() {
                resizeCanvas();
                renderer.render(scene, camera);
                var link = document.createElement("a");
                link.download = "jersey-preview-" + Date.now() + ".png";
                link.href = renderer.domElement.toDataURL("image/png");
                link.click();
            }

            document
                .getElementById("btn-export")
                .addEventListener("click", exportDesign);

            document
                .getElementById("btn-reset")
                .addEventListener("click", function () {
                    ZONE_KEYS.forEach(function (k) {
                        zones[k] = makeZoneState();
                    });
                    brightness = 100;
                    brightnessEl.value = 100;
                    logoImg = null;
                    logoDataUrl = null;
                    logoSize = 18;
                    logoX = 256;
                    logoY = 560;
                    logoRotation = 0;
                    logoMirror = false;
                    textValue = "";
                    textColor = "#ffffff";
                    textSize = 12;
                    FRONT_CX = 256;
                    textY = 640;
                    logoLabel.textContent = "Upload Logo (PNG transparan)";
                    logoUpload.value = "";
                    if (logoSizeEl) logoSizeEl.value = 18;
                    if (logoRotationEl) logoRotationEl.value = 0;
                    if (logoMirrorEl) logoMirrorEl.checked = false;
                    if (textInput) textInput.value = "";
                    if (textColorEl) textColorEl.value = "#ffffff";
                    if (textSizeEl) textSizeEl.value = 12;
                    document.getElementById("logo-size-label").textContent =
                        "18%";
                    document.getElementById(
                        "logo-rotation-label",
                    ).textContent = "0°";
                    document.getElementById("text-size-label").textContent =
                        "12%";
                    setActiveZone("all");
                });

            function getSnapshot() {
                return {
                    v: 1,
                    brightness: brightness,
                    activeZone: activeZone,
                    zones: JSON.parse(JSON.stringify(zones)),
                    logo: {
                        data: logoDataUrl,
                        size: logoSize,
                        x: logoX,
                        y: logoY,
                        rotation: logoRotation,
                        mirror: logoMirror,
                    },
                    text: {
                        value: textValue,
                        color: textColor,
                        size: textSize,
                        x: FRONT_CX,
                        y: textY,
                    },
                };
            }

            function applySnapshot(snap) {
                if (!snap) return;
                if (snap.brightness != null) {
                    brightness = snap.brightness;
                    brightnessEl.value = brightness;
                }
                if (snap.zones) {
                    ZONE_KEYS.forEach(function (k) {
                        zones[k] = Object.assign(
                            makeZoneState(),
                            snap.zones[k] || {},
                        );
                    });
                }
                if (snap.logo) {
                    logoSize = snap.logo.size != null ? snap.logo.size : 18;
                    logoX = snap.logo.x != null ? snap.logo.x : 256;
                    logoY = snap.logo.y != null ? snap.logo.y : 560;
                    logoRotation =
                        snap.logo.rotation != null ? snap.logo.rotation : 0;
                    logoMirror = snap.logo.mirror === true;
                    if (logoSizeEl) logoSizeEl.value = logoSize;
                    if (logoRotationEl) logoRotationEl.value = logoRotation;
                    if (logoMirrorEl) logoMirrorEl.checked = logoMirror;
                    document.getElementById("logo-size-label").textContent =
                        logoSize + "%";
                    document.getElementById(
                        "logo-rotation-label",
                    ).textContent = Math.round(logoRotation) + "°";
                    loadLogo(snap.logo.data);
                } else {
                    logoImg = null;
                    logoDataUrl = null;
                }
                if (snap.text) {
                    textValue = snap.text.value || "";
                    textColor = snap.text.color || "#ffffff";
                    textSize = snap.text.size != null ? snap.text.size : 12;
                    FRONT_CX = snap.text.x != null ? snap.text.x : 256;
                    textY = snap.text.y != null ? snap.text.y : 640;
                    if (textInput) textInput.value = textValue;
                    if (textColorEl) textColorEl.value = textColor;
                    if (textSizeEl) textSizeEl.value = textSize;
                    document.getElementById("text-size-label").textContent =
                        textSize + "%";
                }
                setActiveZone(snap.activeZone || "all");
            }

            function loadLogo(dataUrl) {
                if (!dataUrl) {
                    logoImg = null;
                    logoDataUrl = null;
                    return;
                }
                var img = new Image();
                img.onload = function () {
                    logoImg = img;
                    logoDataUrl = dataUrl;
                    syncTexture();
                };
                img.src = dataUrl;
            }

            // Expose a small API for integration/testing
            window.__jersey = {
                getSnapshot: getSnapshot,
                applySnapshot: applySnapshot,
                exportDesign: exportDesign,
                getOverlayScreenPoint: getOverlayScreenPoint,
            };
        }
    })();
</script>

<!-- Hexacolor plate picker for "Warna Dasar" -->
<script is:inline>
    (function () {
        var colorBaseInput = document.getElementById("color-base");
        var plate = document.getElementById("color-plate");
        var plateWrap = plate && plate.parentElement;
        var plateCursor = document.getElementById("plate-cursor");
        var hueSlider = document.getElementById("hue-slider");
        var hueThumb = document.getElementById("hue-thumb");
        var swatch = document.getElementById("color-swatch");
        var hexInput = document.getElementById("hex-input");
        var hexCopy = document.getElementById("hex-copy");
        var valRgb = document.getElementById("val-rgb");
        var valCmyk = document.getElementById("val-cmyk");
        var valHsv = document.getElementById("val-hsv");
        var valHsl = document.getElementById("val-hsl");
        if (!plate || !colorBaseInput) return;

        var ctx = plate.getContext("2d");
        var hue = 56,
            sat = 0.93,
            val = 1;

        function clamp(n, min, max) {
            return Math.min(max, Math.max(min, n));
        }

        function hsvToRgb(h, s, v) {
            var c = v * s;
            var x = c * (1 - Math.abs(((h / 60) % 2) - 1));
            var m = v - c;
            var r = 0,
                g = 0,
                b = 0;
            if (h < 60) {
                r = c;
                g = x;
            } else if (h < 120) {
                r = x;
                g = c;
            } else if (h < 180) {
                g = c;
                b = x;
            } else if (h < 240) {
                g = x;
                b = c;
            } else if (h < 300) {
                r = x;
                b = c;
            } else {
                r = c;
                b = x;
            }
            return {
                r: Math.round((r + m) * 255),
                g: Math.round((g + m) * 255),
                b: Math.round((b + m) * 255),
            };
        }

        function rgbToHsv(r, g, b) {
            r /= 255;
            g /= 255;
            b /= 255;
            var max = Math.max(r, g, b),
                min = Math.min(r, g, b);
            var d = max - min;
            var h = 0;
            if (d !== 0) {
                if (max === r) h = ((g - b) / d) % 6;
                else if (max === g) h = (b - r) / d + 2;
                else h = (r - g) / d + 4;
                h *= 60;
                if (h < 0) h += 360;
            }
            var s = max === 0 ? 0 : d / max;
            return { h: h, s: s, v: max };
        }

        function rgbToHsl(r, g, b) {
            r /= 255;
            g /= 255;
            b /= 255;
            var max = Math.max(r, g, b),
                min = Math.min(r, g, b);
            var h = 0,
                s = 0,
                l = (max + min) / 2;
            var d = max - min;
            if (d !== 0) {
                s = d / (1 - Math.abs(2 * l - 1));
                if (max === r) h = ((g - b) / d) % 6;
                else if (max === g) h = (b - r) / d + 2;
                else h = (r - g) / d + 4;
                h *= 60;
                if (h < 0) h += 360;
            }
            return { h: h, s: s, l: l };
        }

        function rgbToCmyk(r, g, b) {
            r /= 255;
            g /= 255;
            b /= 255;
            var k = 1 - Math.max(r, g, b);
            if (k === 1) return { c: 0, m: 0, y: 0, k: 100 };
            var c = (1 - r - k) / (1 - k);
            var m = (1 - g - k) / (1 - k);
            var y = (1 - b - k) / (1 - k);
            return {
                c: Math.round(c * 100),
                m: Math.round(m * 100),
                y: Math.round(y * 100),
                k: Math.round(k * 100),
            };
        }

        function toHex2(n) {
            return clamp(Math.round(n), 0, 255).toString(16).padStart(2, "0");
        }

        function rgbToHex(r, g, b) {
            return "#" + toHex2(r) + toHex2(g) + toHex2(b);
        }

        function hexToRgb(hex) {
            hex = hex.replace("#", "").trim();
            if (hex.length === 3) {
                hex = hex
                    .split("")
                    .map(function (c) {
                        return c + c;
                    })
                    .join("");
            }
            if (!/^[0-9a-fA-F]{6}$/.test(hex)) return null;
            return {
                r: parseInt(hex.slice(0, 2), 16),
                g: parseInt(hex.slice(2, 4), 16),
                b: parseInt(hex.slice(4, 6), 16),
            };
        }

        function drawPlate() {
            var w = plate.width,
                h = plate.height;
            ctx.fillStyle = "hsl(" + hue + ", 100%, 50%)";
            ctx.fillRect(0, 0, w, h);
            var whiteGrad = ctx.createLinearGradient(0, 0, w, 0);
            whiteGrad.addColorStop(0, "rgba(255,255,255,1)");
            whiteGrad.addColorStop(1, "rgba(255,255,255,0)");
            ctx.fillStyle = whiteGrad;
            ctx.fillRect(0, 0, w, h);
            var blackGrad = ctx.createLinearGradient(0, 0, 0, h);
            blackGrad.addColorStop(0, "rgba(0,0,0,0)");
            blackGrad.addColorStop(1, "rgba(0,0,0,1)");
            ctx.fillStyle = blackGrad;
            ctx.fillRect(0, 0, w, h);
        }

        function positionHandles() {
            plateCursor.style.left = sat * 100 + "%";
            plateCursor.style.top = (1 - val) * 100 + "%";
            hueThumb.style.left = (hue / 360) * 100 + "%";
        }

        function updateReadouts(rgb) {
            var hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
            var cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
            var hex = rgbToHex(rgb.r, rgb.g, rgb.b);
            swatch.style.backgroundColor = hex;
            hexInput.value = hex.toUpperCase();
            valRgb.textContent = rgb.r + ", " + rgb.g + ", " + rgb.b;
            valCmyk.textContent =
                cmyk.c + "%, " + cmyk.m + "%, " + cmyk.y + "%, " + cmyk.k + "%";
            valHsv.textContent =
                Math.round(hue) +
                "°, " +
                Math.round(sat * 100) +
                "%, " +
                Math.round(val * 100) +
                "%";
            valHsl.textContent =
                Math.round(hsl.h) +
                "°, " +
                Math.round(hsl.s * 100) +
                "%, " +
                Math.round(hsl.l * 100) +
                "%";
            return hex;
        }

        function applyColor(dispatch) {
            var rgb = hsvToRgb(hue, sat, val);
            var hex = updateReadouts(rgb);
            positionHandles();
            if (colorBaseInput.value !== hex) {
                colorBaseInput.value = hex;
                if (dispatch !== false) {
                    colorBaseInput.dispatchEvent(
                        new Event("input", { bubbles: true }),
                    );
                }
            }
        }

        function setFromHex(hex) {
            var rgb = hexToRgb(hex);
            if (!rgb) return;
            var hsv = rgbToHsv(rgb.r, rgb.g, rgb.b);
            hue = hsv.h;
            sat = hsv.s;
            val = hsv.v;
            drawPlate();
            applyColor();
        }

        function plateFromEvent(e) {
            var rect = plateWrap.getBoundingClientRect();
            var x = clamp(
                (e.clientX !== undefined ? e.clientX : e.touches[0].clientX) -
                    rect.left,
                0,
                rect.width,
            );
            var y = clamp(
                (e.clientY !== undefined ? e.clientY : e.touches[0].clientY) -
                    rect.top,
                0,
                rect.height,
            );
            sat = rect.width === 0 ? 0 : x / rect.width;
            val = rect.height === 0 ? 0 : 1 - y / rect.height;
            applyColor();
        }

        function hueFromEvent(e) {
            var rect = hueSlider.getBoundingClientRect();
            var x = clamp(
                (e.clientX !== undefined ? e.clientX : e.touches[0].clientX) -
                    rect.left,
                0,
                rect.width,
            );
            hue = rect.width === 0 ? 0 : (x / rect.width) * 360;
            drawPlate();
            applyColor();
        }

        var draggingPlate = false;
        var draggingHue = false;

        plate.addEventListener("pointerdown", function (e) {
            draggingPlate = true;
            plate.setPointerCapture(e.pointerId);
            plateFromEvent(e);
        });
        plate.addEventListener("pointermove", function (e) {
            if (draggingPlate) plateFromEvent(e);
        });
        plate.addEventListener("pointerup", function () {
            draggingPlate = false;
        });

        hueSlider.addEventListener("pointerdown", function (e) {
            draggingHue = true;
            hueSlider.setPointerCapture(e.pointerId);
            hueFromEvent(e);
        });
        hueSlider.addEventListener("pointermove", function (e) {
            if (draggingHue) hueFromEvent(e);
        });
        hueSlider.addEventListener("pointerup", function () {
            draggingHue = false;
        });

        hexInput.addEventListener("change", function () {
            var v = hexInput.value.trim();
            if (v[0] !== "#") v = "#" + v;
            if (hexToRgb(v)) {
                setFromHex(v);
            } else {
                // invalid input, revert to current value
                applyColor(false);
            }
        });

        hexCopy.addEventListener("click", function () {
            var hex = colorBaseInput.value;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(hex);
            }
            var original = hexCopy.innerHTML;
            hexCopy.classList.add("text-brand-400");
            setTimeout(function () {
                hexCopy.classList.remove("text-brand-400");
            }, 600);
        });

        // Keep the plate in sync when a preset swatch or the reset button
        // changes the underlying #color-base value.
        document
            .querySelectorAll("#preset-colors button")
            .forEach(function (btn) {
                btn.addEventListener("click", function () {
                    setFromHex(btn.dataset.color);
                });
            });
        var resetBtn = document.getElementById("btn-reset");
        if (resetBtn) {
            resetBtn.addEventListener("click", function () {
                setFromHex("#fef013");
            });
        }

        // Initial paint
        setFromHex(colorBaseInput.value || "#fef013");

        // Exposed so other code (preset swatches, reset) can resync this
        // plate's UI without duplicating the hex/HSV conversion logic.
        window.__syncColorPlate = setFromHex;

        if (typeof ResizeObserver !== "undefined") {
            new ResizeObserver(drawPlate).observe(plateWrap);
        }
    })();
</script>
