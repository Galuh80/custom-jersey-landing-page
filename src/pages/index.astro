---
import fs from "node:fs";
import { fileURLToPath } from "node:url";
import Layout from "../layouts/Layout.astro";

// Resolve relative to this file so it works regardless of process.cwd().
const portfolioDir = fileURLToPath(
    new URL("../../public/portfolio/", import.meta.url),
);
let gallery = [];
try {
    gallery = fs
        .readdirSync(portfolioDir)
        .filter((file) => /\.(webp|jpe?g|png|gif|avif)$/i.test(file))
        .sort((a, b) =>
            a.localeCompare(b, undefined, {
                numeric: true,
                sensitivity: "base",
            }),
        )
        .map((file) => `/portfolio/${file}`);
} catch {
    gallery = [];
}
// If the folder could not be read at build time, fall back to the shipped
// images so the production gallery never renders empty.
if (!gallery.length) {
    gallery = Array.from(
        { length: 16 },
        (_, i) => `/portfolio/portfolio-${i + 1}.webp`,
    );
}

const benefits = [
    {
        title: "Desain Gratis",
        desc: "Tim designer siap bantu wujudkan ide kamu, termasuk dari AI concept.",
        icon: "🎨",
    },
    {
        title: "No Minimum Order",
        desc: "Bisa order satuan. Cocok untuk personal maupun tim kecil.",
        icon: "📦",
    },
    {
        title: "Produksi Transparan",
        desc: "Proses di-update real-time. Anti ghosting, anti lama.",
        icon: "🔍",
    },
    {
        title: "Bahan Premium",
        desc: "Dry-fit, moisture-wicking, dan opsi bahan pro sesuai budget.",
        icon: "👕",
    },
];

const steps = [
    {
        step: "01",
        title: "Konsultasi",
        desc: "Chat WhatsApp, ceritakan kebutuhan & kirim referensi.",
    },
    {
        step: "02",
        title: "Desain & Mockup",
        desc: "Kami buatkan mockup. Revisi sampai kamu approve.",
    },
    {
        step: "03",
        title: "Produksi",
        desc: "Setelah DP, kami produksi. Progress di-update real-time.",
    },
    {
        step: "04",
        title: "Pengiriman",
        desc: "Jersey dikirim ke alamat kamu. Ready dipakai!",
    },
];

const faqs = [
    {
        q: "Berapa minimum order?",
        a: "Tidak ada minimum order. Bisa mulai dari 1 pcs. Harga lebih hemat untuk quantity lebih besar.",
    },
    {
        q: "Berapa lama proses produksi?",
        a: "Rata-rata 1–7 hari kerja tergantung quantity dan antrian. Ada opsi express untuk kebutuhan mendesak.",
    },
    {
        q: "Apakah desain benar-benar gratis?",
        a: "Ya. Desain dan revisi (reasonable) tidak dikenakan biaya tambahan.",
    },
    {
        q: "Bahan apa saja yang tersedia?",
        a: "Dry-fit, Milano, Serena, dan beberapa opsi premium lainnya. Kami sesuaikan dengan budget dan kebutuhan.",
    },
    {
        q: "Bagaimana sistem pembayaran?",
        a: "Biasanya DP 50–70% di awal, pelunasan sebelum pengiriman. Transfer bank / e-wallet tersedia.",
    },
];
