    <script>
        import { supabase, getPublicUrl } from "../lib/supabase";

        const track = document.getElementById("gallery-track");
        const grid = document.getElementById("gallery-grid");
        const prevBtn = document.getElementById("gallery-prev");
        const nextBtn = document.getElementById("gallery-next");
        const PER_PAGE = 16;
        let pageIndex = 0;
        let pageCount = 1;

        function card(src, alt, file) {
            const item = document.createElement("div");
            item.className =
                "group aspect-[4/3] rounded-xl overflow-hidden border border-white/5 bg-dark-800";
            if (file) item.setAttribute("data-file", file);
            const img = document.createElement("img");
            img.src = src;
            img.alt = alt || "Jersey custom Surly Apparel";
            img.loading = "lazy";
            img.decoding = "async";
            img.className =
                "w-full h-full object-contain transition duration-500 group-hover:scale-105";
            item.appendChild(img);
            return item;
        }

        function updateArrows() {
            const show = pageCount > 1;
            prevBtn.classList.toggle("hidden", !show);
            nextBtn.classList.toggle("hidden", !show);
            prevBtn.classList.toggle("flex", show);
            nextBtn.classList.toggle("flex", show);
            prevBtn.disabled = pageIndex === 0;
            nextBtn.disabled = pageIndex === pageCount - 1;
            prevBtn.classList.toggle("opacity-30", pageIndex === 0);
            nextBtn.classList.toggle(
                "opacity-30",
                pageIndex === pageCount - 1,
            );
            track.style.transform = `translateX(-${pageIndex * 100}%)`;
        }

        function buildPages(items) {
            pageCount = Math.ceil(items.length / PER_PAGE) || 1;
            track.innerHTML = "";
            for (let page = 0; page < pageCount; page++) {
                const pageEl = document.createElement("div");
                pageEl.className =
                    "gallery-page shrink-0 w-full grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4";
                items
                    .slice(page * PER_PAGE, (page + 1) * PER_PAGE)
                    .forEach((entry) => {
                        pageEl.appendChild(card(entry.src, entry.alt, entry.file));
                    });
                track.appendChild(pageEl);
            }
            pageIndex = 0;
            updateArrows();
        }

        prevBtn.addEventListener("click", () => {
            if (pageIndex > 0) {
                pageIndex -= 1;
                updateArrows();
            }
        });
        nextBtn.addEventListener("click", () => {
            if (pageIndex < pageCount - 1) {
                pageIndex += 1;
                updateArrows();
            }
        });

        if (grid && supabase) {
            const localItems = Array.from(
                grid.querySelectorAll("[data-file]"),
            ).map((el) => ({
                file: el.getAttribute("data-file"),
                src: el.querySelector("img")?.getAttribute("src"),
                alt: el.querySelector("img")?.getAttribute("alt"),
            }));
            const existing = new Set(localItems.map((item) => item.file));

            supabase
                .from("portfolios")
                .select("path")
                .order("created_at", { ascending: true })
                .then(({ data, error }) => {
                    if (error || !data) return;
                    const extra = data
                        .filter((row) => row.path && !existing.has(row.path))
                        .map((row) => ({
                            file: row.path,
                            src: getPublicUrl(row.path),
                            alt: "Jersey custom Surly Apparel",
                        }));
                    if (!extra.length) return;
                    buildPages(localItems.concat(extra));
                });
        }
    </script>
