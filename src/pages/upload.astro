                    <div><span class="text-slate-500">Nomor :</span> <b>${esc(no)}</b></div>
                    <div class="text-right"><span class="text-slate-500">Tanggal :</span> <b>${tgl}</b></div>
<div class="col-span-2"><span class="text-slate-500">Pelanggan :</span> <b>${esc(customer)}</b></div>
                  </div>

                  <table>
