        function updateGalleryBulk() {
            document.getElementById("gallery-bulk-count").textContent =
                selG.size;
            document.getElementById("gallery-bulk").disabled = selG.size === 0;
        }

        async function loadList() {
            let localFiles = [];
            try {
                localFiles = JSON.parse(
                    document.getElementById("local-portfolio").textContent ||
                        "[]",
                );
            } catch {
                localFiles = [];
            }
            const localRows = localFiles.map((name) => ({
                id: "local:" + name,
                path: name,
                isLocal: true,
            }));
            const { data, error } = await supabase
                .from("portfolios")
                .select("id,path,created_at")
                .order("created_at", { ascending: false });
            if (error) {
                setStatus("Gagal memuat daftar: " + error.message, "error");
                return;
            }
            // Mix uploaded (Supabase) images with the built-in portfolio images.
            const seen = new Set();
            const combined = [];
            [
                ...(data || []).map((r) => ({ ...r, isLocal: false })),
                ...localRows,
            ].forEach((row) => {
                if (seen.has(row.path)) return;
                seen.add(row.path);
                combined.push(row);
            });
            initGalleryTable(combined);
        }

        async function removeImage(row) {
            if (row.isLocal || row.id.startsWith("local:")) return;
            if (!window.confirm(`Hapus "${row.path}" ?`)) return;
            const { error: storageError } = await supabase.storage
                .from(SUPABASE_BUCKET)
                .remove([row.path]);
            if (storageError) {
                setStatus("Gagal hapus file: " + storageError.message, "error");
                return;
            }
            const { error } = await supabase
                .from("portfolios")
                .delete()
                .eq("id", row.id);
            if (error) {
                setStatus("Gagal hapus data: " + error.message, "error");
                return;
            }
            selG.delete(row.id);
            setStatus("Dihapus: " + row.path, "ok");
            loadList();
        }

        async function removeSelectedGallery() {
            const rows = galleryStore.filter(
                (r) => selG.has(r.id) && !r.isLocal,
            );
            if (!rows.length) return;
            if (!window.confirm(`Hapus ${rows.length} gambar terpilih?`)) return;
            for (const row of rows) {
                await supabase.storage.from(SUPABASE_BUCKET).remove([row.path]);
                await supabase.from("portfolios").delete().eq("id", row.id);
            }
            selG.clear();
            setStatus(`Dihapus ${rows.length} gambar`, "ok");
            loadList();
        }

        document
            .getElementById("gallery-bulk")
            .addEventListener("click", removeSelectedGallery);

        function showView(name) {
            loginView.classList.toggle("hidden", name !== "login");
            appView.classList.toggle("hidden", name !== "app");
            warning.classList.toggle("hidden", name !== "warn");
        }

        function renderSession(session) {
            if (session) {
                userEmail.textContent = session.user.email || "";
                showView("app");
                loadList();
            } else {
                showView("login");
            }
        }

        if (!supabase) {
            showView("warn");
        } else {
            supabase.auth.getSession().then(({ data }) => {
                renderSession(data.session);
            });
            supabase.auth.onAuthStateChange((_event, session) => {
                renderSession(session);
            });

            loginBtn.addEventListener("click", async () => {
                loginStatus.textContent = "";
                const { error } = await supabase.auth.signInWithPassword({
                    email: emailInput.value.trim(),
                    password: passwordInput.value,
                });
                if (error) loginStatus.textContent = error.message;
            });

            logoutBtn.addEventListener("click", () => supabase.auth.signOut());

            fileInput.addEventListener("change", () => {
                const file = fileInput.files[0];
                if (!file) return;
                preview.src = URL.createObjectURL(file);
                preview.classList.remove("hidden");
                dropLabel.classList.add("hidden");
                setStatus("");
            });

            uploadBtn.addEventListener("click", async () => {
                const file = fileInput.files[0];
                if (!file) {
                    setStatus("Pilih gambar dulu.", "error");
                    return;
                }
                let step = "konversi";
                try {
                    const { data: sessionData } = await supabase.auth.getSession();
                    if (!sessionData.session) {
                        throw new Error("Belum login (session kosong)");
                    }
                    setStatus("Mengonversi ke WebP...");
                    const blob = await toWebp(file);
                    const path = slugify(file.name) + "-" + Date.now() + ".webp";

                    step = "upload Storage";
                    setStatus("Mengunggah ke Storage...");
                    const { error: uploadError } = await supabase.storage
                        .from(SUPABASE_BUCKET)
                        .upload(path, blob, {
                            contentType: "image/webp",
                            upsert: false,
                        });
                    if (uploadError) throw uploadError;

                    step = "insert tabel";
                    setStatus("Menyimpan data...");
                    const { error: insertError } = await supabase
                        .from("portfolios")
                        .insert({ path });
                    if (insertError) throw insertError;

                    setStatus("Berhasil: " + path, "ok");
                    fileInput.value = "";
                    preview.src = "";
                    preview.classList.add("hidden");
                    dropLabel.classList.remove("hidden");
                    loadList();
                } catch (error) {
                    const extra = [error.code, error.details, error.hint]
                        .filter(Boolean)
                        .join(" | ");
                    setStatus(
                        `Gagal di ${step}: ${error.message}` +
                            (extra ? ` (${extra})` : ""),
                        "error",
                    );
                }
            });

            refreshBtn.addEventListener("click", loadList);

            // ---------- Tabs: Upload / Nota Online ----------
            const tabUpload = document.getElementById("tab-upload");
            const tabNota = document.getElementById("tab-nota");
            const panelUpload = document.getElementById("panel-upload");
            const panelNota = document.getElementById("panel-nota");

