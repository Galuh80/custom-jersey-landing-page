                        <th class="num" style="width:110px">Harga</th>
                        <th class="num" style="width:120px">Jumlah</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${rows || '<tr><td colspan="5" class="text-center text-slate-400">— belum ada item —</td></tr>'}
                    </tbody>
                  </table>

                  <div class="mt-3 flex justify-end text-sm">
                    <table style="width:auto;border-collapse:collapse">
                      <tr><td class="py-1 pr-6 text-slate-600">Subtotal</td><td class="py-1 num"><b>${fmt(subtotal)}</b></td></tr>
                      <tr><td class="py-1 pr-6 text-slate-600">Diskon</td><td class="py-1 num">- ${fmt(discount)}</td></tr>
                      <tr>
                        <td class="py-2 pr-6 font-bold uppercase">Total</td>
                        <td class="py-2 num font-bold bg-slate-100 px-2">${fmt(total)}</td>
                      </tr>
                    </table>
                  </div>

                  ${
                      notes
                          ? `<div class="mt-3 text-xs text-slate-600 border-t border-slate-200 pt-2">${esc(notes)}</div>`
                          : ""
                  }
                `;
            }

            notaForm.addEventListener("input", renderNota);
            notaItemsTbody.addEventListener("click", (e) => {
                if (e.target.classList.contains("del-row")) {
                    e.target.closest(".nota-row").remove();
                    renderNota();
                }
            });
            document.getElementById("add-item").addEventListener("click", () => {
                itemRow();
                renderNota();
            });

            const notaStatus = document.getElementById("nota-status");
            const notaCount = document.getElementById("nota-count");

            // --- Nota tersimpan (DataTable) ---
            const selN = new Set();
            let nTable = null;
            let notaStore = [];

            function notaStatusMsg(msg, kind) {
                notaStatus.textContent = msg || "";
                notaStatus.className =
                    "text-sm " +
                    (kind === "ok"
                        ? "text-emerald-300"
                        : kind === "error"
                          ? "text-red-300"
                          : "text-white/50");
            }

            function buildNotaData() {
                renderNota();
                const items = readItems();
                const { subtotal, discount, total } = updateTotals();
                return {
                    nota_number:
                        document.getElementById("nota-number").value || "NOT-0000",
                    nota_date:
                        document.getElementById("nota-date").value || dateToday(),
                    customer_name:
                        document.getElementById("nota-customer").value || "",
                    customer_wa:
                        document.getElementById("nota-wa-input").value || "",
                    customer_address:
                        document.getElementById("nota-address").value || "",
                    items,
                    subtotal,
                    discount,
                    total,
                    notes: document.getElementById("nota-notes").value || "",
                };
            }

            async function saveNota() {
                const data = buildNotaData();
                const { error } = await supabase.from("notas").insert(data);
                if (error) throw error;
                return data;
            }

            const nCheckHtml = (row) =>
                `<input type="checkbox" class="n-check accent-yellow-400" data-id="${row.id}" ${selN.has(row.id) ? "checked" : ""} />`;
            const nActionHtml = (row) =>
                `<div class="flex gap-2">
                    <button type="button" class="n-load px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-white/80 text-xs" data-id="${row.id}">Muat</button>
                    <button type="button" class="n-del px-2.5 py-1 rounded-lg bg-white/5 hover:bg-red-500/20 text-red-300/80 text-xs" data-id="${row.id}" data-no="${row.nota_number}">Hapus</button>
                </div>`;

            function notaFallback(data) {
                const tbody = document.querySelector("#tbl-nota tbody");
                tbody.innerHTML = "";
                (data || []).forEach((row) => {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `<td><input type="checkbox" class="n-check" data-id="${row.id}"></td>
                        <td>${esc(row.nota_number)}</td><td>${esc((row.nota_date || "").slice(0, 10))}</td>
                        <td>${esc(row.customer_name) || "-"}</td><td class="text-right">${fmt(row.total)}</td>
                        <td>${nActionHtml(row)}</td>`;
                    tr.querySelector(".n-check").addEventListener("change", function () {
                        if (this.checked) selN.add(row.id);
                        else selN.delete(row.id);
                        updateNotaBulk();
                    });
                    tr.querySelector(".n-load").addEventListener("click", () => fillNota(row.id));
                    tr.querySelector(".n-del").addEventListener("click", () => deleteNota(row.id, row.nota_number));
                    tbody.appendChild(tr);
                });
                updateNotaBulk();
            }

            function initNotaTable(data) {
                notaStore = data || [];
                notaCount.textContent = `(${notaStore.length})`;
                if (!window.jQuery || !window.jQuery.fn.DataTable) {
                    notaFallback(notaStore);
