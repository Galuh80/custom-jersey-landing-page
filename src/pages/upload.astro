---
import fs from "node:fs";
import { fileURLToPath } from "node:url";
import Layout from "../layouts/Layout.astro";

// Built-in images shipped in /public/portfolio/, mixed with Supabase uploads.
// Resolved relative to this file so it works regardless of process.cwd().
let localPortfolio = [];
try {
    const portfolioDir = fileURLToPath(
        new URL("../../public/portfolio/", import.meta.url),
    );
    localPortfolio = fs
        .readdirSync(portfolioDir)
        .filter((file) => /\.(webp|jpe?g|png|gif|avif)$/i.test(file))
        .sort((a, b) =>
            a.localeCompare(b, undefined, {
                numeric: true,
                sensitivity: "base",
            }),
        );
} catch {
    localPortfolio = Array.from(
        { length: 16 },
        (_, i) => `portfolio-${i + 1}.webp`,
    );
}
---

<Layout
    title="Upload Galeri | Surly Apparel"
    description="Unggah gambar produksi, dikonversi ke WebP otomatis dan masuk ke Galeri Produksi."
>
    <header
        class="sticky top-0 z-50 bg-dark-950/80 backdrop-blur-md border-b border-white/5"
    >
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 md:h-20">
                <a href="/" class="flex items-center gap-2">
                    <img
                        src="/logo.png"
                        alt="Surly Apparel logo"
                        width="40"
                        height="40"
                        class="w-10 h-10 object-contain"
                    />
                    <span
                        class="font-display font-bold text-xl tracking-tight hidden sm:block whitespace-nowrap"
                    >
                        Surly Apparel
                    </span>
                </a>
                <a
                    href="/"
                    class="text-sm font-medium text-white/70 hover:text-white transition"
                >
                    ← Beranda
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
        <h1 class="font-display text-3xl md:text-4xl font-bold mb-2">
            Upload Galeri Produksi
        </h1>
        <p class="text-white/60 mb-8 text-sm md:text-base">
            Gambar dikonversi ke WebP lalu diunggah ke Supabase Storage dan
            langsung tampil di Galeri Produksi.
        </p>

        <div
            id="setup-warning"
            class="hidden mb-6 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-200 text-sm px-4 py-3"
        >
            Supabase belum dikonfigurasi. Isi
            <code>PUBLIC_SUPABASE_URL</code>,
            <code>PUBLIC_SUPABASE_ANON_KEY</code>, dan
            <code>PUBLIC_SUPABASE_BUCKET</code> di <code>.env</code>.
        </div>

        <!-- Login -->
        <section
            id="login-view"
            class="hidden bg-dark-800/70 border border-white/5 rounded-2xl p-6 max-w-md"
        >
            <h2 class="font-display font-semibold mb-4">Masuk sebagai Admin</h2>
            <div class="space-y-3">
                <input
                    id="email"
                    type="email"
                    placeholder="Email"
                    autocomplete="username"
                    class="w-full bg-dark-900/60 border border-white/10 rounded-lg px-3 py-2 text-sm text-white/90 focus:outline-none focus:border-brand-500/50"
                />
                <input
                    id="password"
                    type="password"
                    placeholder="Password"
                    autocomplete="current-password"
                    class="w-full bg-dark-900/60 border border-white/10 rounded-lg px-3 py-2 text-sm text-white/90 focus:outline-none focus:border-brand-500/50"
                />
                <button
                    type="button"
                    id="login"
                    class="w-full bg-brand-500 hover:bg-brand-400 text-dark-950 font-semibold px-5 py-2.5 rounded-full transition btn-press"
                >
                    Masuk
                </button>
                <p id="login-status" class="text-sm text-red-300"></p>
            </div>
        </section>

        <!-- App -->
        <div id="app-view" class="hidden">
            <div class="flex items-center justify-between mb-6">
                <p class="text-sm text-white/50">
                    Masuk sebagai <span id="user-email" class="text-white/80"></span>
                </p>
                <button
                    type="button"
                    id="logout"
                    class="text-sm text-white/60 hover:text-white transition"
                >
                    Keluar
                </button>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
                <button
                    type="button"
                    id="tab-upload"
                    class="px-4 py-2 rounded-lg text-sm font-medium transition bg-brand-500 text-dark-950"
                >
                    Upload Galeri
                </button>
                <button
                    type="button"
                    id="tab-nota"
                    class="px-4 py-2 rounded-lg text-sm font-medium transition bg-white/5 text-white/70 hover:bg-white/10"
                >
                    Nota Online
                </button>
            </div>

            <div id="panel-upload">
                <section
                    class="bg-dark-800/70 border border-white/5 rounded-2xl p-6 mb-10"
                >
                    <h2 class="font-display font-semibold mb-4">Tambah Gambar</h2>
                    <label
                        class="flex flex-col items-center justify-center w-full h-40 border-2 border-dashed border-white/15 rounded-xl cursor-pointer hover:border-brand-500/40 transition overflow-hidden"
                    >
                        <img
                            id="preview"
                            class="hidden h-full w-full object-contain"
                        />
                        <span
                            id="drop-label"
                            class="text-sm text-white/50 p-4 text-center"
                        >
                            Klik untuk pilih gambar (JPG/PNG/WebP)
                        </span>
                        <input
                            type="file"
                            id="file"
                            accept="image/*"
                            class="hidden"
                        />
                    </label>
                    <div class="flex flex-wrap items-center gap-3 mt-4">
                        <button
                            type="button"
                            id="upload"
                            class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-dark-950 font-semibold px-5 py-2.5 rounded-full transition btn-press"
                        >
                            Konversi & Upload
                        </button>
                        <span id="status" class="text-sm text-white/50"></span>
                    </div>
                </section>

                <section>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-display font-semibold">
                            Galeri Saat Ini
                            <span
                                id="count"
                                class="text-white/40 font-normal"
                            >
                                (0)
                            </span>
                        </h2>
                        <button
                            type="button"
                            id="refresh"
                            class="text-sm text-white/60 hover:text-white transition"
                        >
                            Muat ulang
                        </button>
                    </div>
                    <div
                        class="bg-dark-800/40 border border-white/5 rounded-2xl p-3 overflow-x-auto"
                    >
                        <div
                            class="flex items-center gap-3 mb-2"
                            id="gallery-bulk-bar"
                        >
                            <button
                                type="button"
                                id="gallery-bulk"
                                class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-red-500/20 text-red-300/80 text-xs font-medium transition"
                            >
                                Hapus Terpilih (<span id="gallery-bulk-count">0</span>)
                            </button>
                        </div>
                        <table
                            id="tbl-gallery"
                            class="w-full table-fixed text-sm text-white/80"
                        >
                            <thead>
                                <tr class="text-left text-xs text-white/40">
                                    <th class="w-8">
                                        <input
                                            type="checkbox"
                                            id="sel-all-g"
                                            class="accent-yellow-400"
                                        />
                                    </th>
                                    <th class="w-16">Foto</th>
                                    <th>Nama File</th>
                                    <th class="w-24">Aksi</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </section>
            </div>

            <div id="panel-nota" class="hidden">
                <div class="grid gap-6">
                    <form id="nota-form" class="space-y-4">
                        <div
                            class="bg-dark-800/70 border border-white/5 rounded-2xl p-5"
                        >
                            <h3 class="font-display font-semibold mb-3">
                                Informasi Nota
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label
                                        class="block text-xs text-white/40 mb-1"
                                    >
                                        Nomor Nota
                                    </label>
                                    <input
                                        id="nota-number"
                                        type="text"
                                        class="inp"
                                        placeholder="NOT-2026-0001"
                                    />
                                </div>
                                <div>
                                    <label
                                        class="block text-xs text-white/40 mb-1"
                                    >
                                        Tanggal
                                    </label>
                                    <input id="nota-date" type="date" class="inp" />
                                </div>
                            </div>
                        </div>

                        <div
                            class="bg-dark-800/70 border border-white/5 rounded-2xl p-5"
                        >
                            <h3 class="font-display font-semibold mb-3">
                                Pelanggan
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label
                                        class="block text-xs text-white/40 mb-1"
                                    >
                                        Nama / Tim
                                    </label>
                                    <input
                                        id="nota-customer"
                                        type="text"
                                        class="inp"
                                        placeholder="Contoh: FC Garuda"
                                    />
                                </div>
                                <div>
                                    <label
                                        class="block text-xs text-white/40 mb-1"
                                    >
                                        No. WhatsApp
                                    </label>
                                    <input
                                        id="nota-wa-input"
                                        type="text"
                                        class="inp"
                                        placeholder="0812xxxxxxx"
                                    />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label
                                    class="block text-xs text-white/40 mb-1"
                                >
                                    Alamat / Kota (opsional)
                                </label>
                                <input
                                    id="nota-address"
                                    type="text"
                                    class="inp"
                                    placeholder="Yogyakarta"
                                />
                            </div>
                        </div>

                        <div
                            class="bg-dark-800/70 border border-white/5 rounded-2xl p-5"
                        >
                            <h3 class="font-display font-semibold mb-3">
                                Item Nota
                            </h3>
                            <div class="overflow-x-auto">
                                <div class="min-w-0">
                                    <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_3.75rem_6rem_7rem_1.75rem] gap-1.5 mb-1 px-1 text-xs text-white/40">
                                        <span class="font-medium">Nama / Desain</span>
                                        <span class="font-medium">Qty</span>
                                        <span class="font-medium">Harga</span>
                                        <span class="font-medium text-right">Jumlah</span>
                                        <span></span>
                                    </div>
                                    <div id="nota-items" class="space-y-3 sm:space-y-2"></div>
                                </div>
                            </div>
                            <button
                                type="button"
                                id="add-item"
                                class="mt-3 text-sm text-brand-400 hover:text-brand-300 transition"
                            >
                                + Tambah Baris
                            </button>
                            <div class="mt-3 flex items-center justify-between gap-3">
                                <label class="text-sm text-white/60">
                                    Diskon (Rp)
                                </label>
                                <input
                                    id="nota-discount"
                                    type="number"
                                    min="0"
                                    value="0"
                                    class="inp !w-32"
                                />
                            </div>
                        </div>

                        <div
                            class="bg-dark-800/70 border border-white/5 rounded-2xl p-5"
                        >
                            <label
                                class="block text-xs text-white/40 mb-1"
                            >
                                Keterangan / Term
                            </label>
                            <textarea
                                id="nota-notes"
                                rows="2"
                                class="inp"
                                placeholder="Contoh: DP 50%, pelunasan sebelum kirim."
                            ></textarea>
                            <p
                                id="nota-total"
                                class="mt-3 text-right font-display font-bold text-brand-400 text-lg"
                            >
                                Total: Rp 0
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-3 items-center no-print">
                            <button
                                type="button"
                                id="nota-print"
                                class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-dark-950 font-semibold px-5 py-2.5 rounded-full transition btn-press"
                            >
                                Cetak / Simpan PDF
                            </button>
                            <button
                                type="button"
                                id="nota-wa"
                                class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-white/80 font-medium px-5 py-2.5 rounded-full transition btn-press"
                            >
                                Kirim ke WhatsApp
                            </button>
                            <span id="nota-status" class="text-sm text-white/50"></span>
                        </div>
                    </form>

                    <div>
                        <p class="text-xs text-white/40 mb-2 no-print">
                            Preview nota
                        </p>
                        <div
                            id="nota-sheet"
                            class="bg-white text-slate-900 rounded-lg shadow-xl p-4 sm:p-8 text-sm"
                        ></div>
                    </div>
                </div>

                <section class="mt-8">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-display font-semibold">
                            Nota Tersimpan
                            <span
                                id="nota-count"
                                class="text-white/40 font-normal"
                            >
                                (0)
                            </span>
                        </h2>
                        <button
                            type="button"
                            id="nota-refresh"
                            class="text-sm text-white/60 hover:text-white transition"
                        >
                            Muat ulang
                        </button>
                    </div>
                    <div
                        class="bg-dark-800/40 border border-white/5 rounded-2xl p-3 overflow-x-auto"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <button
                                type="button"
                                id="nota-bulk"
                                class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-red-500/20 text-red-300/80 text-xs font-medium transition"
                            >
                                Hapus Terpilih (<span id="nota-bulk-count">0</span>)
                            </button>
                        </div>
                        <table
                            id="tbl-nota"
                            class="w-full table-fixed text-sm text-white/80"
                        >
                            <thead>
                                <tr class="text-left text-xs text-white/40">
                                    <th class="w-8">
                                        <input
                                            type="checkbox"
                                            id="sel-all-n"
                                            class="accent-yellow-400"
                                        />
                                    </th>
                                    <th>No. Nota</th>
                                    <th class="w-28">Tanggal</th>
                                    <th>Pelanggan</th>
                                    <th class="w-28 text-right">Total</th>
                                    <th class="w-32">Aksi</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <style is:global>
        .inp {
            width: 100%;
            background: rgba(2, 6, 23, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.9);
            outline: none;
        }
        .inp:focus {
            border-color: rgba(254, 240, 19, 0.5);
        }
        .inp::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }
        #nota-sheet table {
            width: 100%;
            border-collapse: collapse;
        }
        #nota-sheet th,
        #nota-sheet td {
            border: 1px solid #cbd5e1;
            padding: 4px 8px;
            text-align: left;
        }
        #nota-sheet th {
            background: #f1f5f9;
        }
        #nota-sheet .num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }
        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            background: rgba(2, 6, 23, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.9);
            border-radius: 0.5rem;
            padding: 0.35rem 0.6rem;
            font-size: 0.8rem;
            margin: 0 0.25rem;
        }
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.8rem;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: rgba(255, 255, 255, 0.85) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            background: rgba(255, 255, 255, 0.06) !important;
            border-radius: 0.4rem;
            padding: 0.2rem 0.7rem !important;
            margin: 0 2px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #fef013 !important;
            color: #020617 !important;
            border-color: #fef013 !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            opacity: 0.4 !important;
        }
        #tbl-gallery,
        #tbl-nota {
            color: rgba(255, 255, 255, 0.8);
        }
        #tbl-gallery thead th,
        #tbl-nota thead th {
            color: rgba(255, 255, 255, 0.5);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            white-space: nowrap;
        }
        #tbl-gallery tbody td,
        #tbl-nota tbody td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: middle;
        }
        .dataTables_wrapper .dataTables_processing {
            background: rgba(2, 6, 23, 0.8) !important;
        }
        #tbl-gallery td.dtr-control::before,
        #tbl-nota td.dtr-control::before {
            color: rgba(255, 255, 255, 0.75);
        }
        table.dataTable.dtr-inline.collapsed
            > tbody
            > tr
            > td.dtr-control:before {
            background-color: #fef013;
            color: #020617;
        }
        table.dataTable.dtr-inline.collapsed
            > tbody
            > tr.parent
            > td.dtr-control:before {
            background-color: #fef013;
            color: #020617;
        }
        ul.dtr-details {
            width: 100%;
            background: rgba(2, 6, 23, 0.5);
        }
        ul.dtr-details li {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.8);
            padding: 0.25rem 0.5rem;
        }
        @media (max-width: 640px) {
            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_filter {
                text-align: left;
                margin-bottom: 0.5rem;
            }
            .dataTables_wrapper .dataTables_filter input {
                width: 100%;
            }
            .dataTables_wrapper .dataTables_paginate {
                margin-top: 0.5rem;
            }
        }
        @media print {
            @page {
                size: A4;
                margin: 12mm;
            }
            body {
                background: #fff !important;
            }
            body * {
                visibility: hidden;
            }
            #nota-sheet,
            #nota-sheet * {
                visibility: visible;
            }
            #nota-sheet {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                box-shadow: none !important;
                border-radius: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>

    <link
        rel="stylesheet"
        href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css"
    />
    <link
        rel="stylesheet"
        href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css"
    />
    <script
        is:inline
        src="https://code.jquery.com/jquery-3.7.1.min.js"
    ></script>
    <script
        is:inline
        src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"
    ></script>
    <script
        is:inline
        src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"
    ></script>

    <script
        is:inline
        type="application/json"
        id="local-portfolio"
        set:html={JSON.stringify(localPortfolio)}
    ></script>

    <script>
        import {
            supabase,
            getPublicUrl,
            SUPABASE_BUCKET,
        } from "../lib/supabase";

        const loginView = document.getElementById("login-view");
        const appView = document.getElementById("app-view");
        const warning = document.getElementById("setup-warning");
        const emailInput = document.getElementById("email");
        const passwordInput = document.getElementById("password");
        const loginBtn = document.getElementById("login");
        const loginStatus = document.getElementById("login-status");
        const logoutBtn = document.getElementById("logout");
        const userEmail = document.getElementById("user-email");
        const fileInput = document.getElementById("file");
        const preview = document.getElementById("preview");
        const dropLabel = document.getElementById("drop-label");
        const uploadBtn = document.getElementById("upload");
        const statusEl = document.getElementById("status");
        const countEl = document.getElementById("count");
        const refreshBtn = document.getElementById("refresh");

        function setStatus(message, kind) {
            statusEl.textContent = message || "";
            statusEl.className =
                "text-sm " +
                (kind === "ok"
                    ? "text-emerald-300"
                    : kind === "error"
                      ? "text-red-300"
                      : "text-white/50");
        }

        function slugify(name) {
            return (
                String(name)
                    .replace(/\.[^.]+$/, "")
                    .toLowerCase()
                    .replace(/[^a-z0-9]+/g, "-")
                    .replace(/^-+|-+$/g, "")
                    .slice(0, 40) || "jersey"
            );
        }

        function toWebp(file) {
            return createImageBitmap(file).then((bitmap) => {
                const canvas = document.createElement("canvas");
                canvas.width = bitmap.width;
                canvas.height = bitmap.height;
                canvas
                    .getContext("2d")
                    .drawImage(bitmap, 0, 0, bitmap.width, bitmap.height);
                if (bitmap.close) bitmap.close();
                return new Promise((resolve, reject) => {
                    canvas.toBlob(
                        (blob) =>
                            blob
                                ? resolve(blob)
                                : reject(new Error("Gagal konversi WebP")),
                        "image/webp",
                        0.85,
                    );
                });
            });
        }

        // --- Galeri (DataTable) ---
        const selG = new Set();
        let gTable = null;
        let galleryStore = [];

        const gImgSrc = (row) =>
            row.isLocal ? "/portfolio/" + row.path : getPublicUrl(row.path);
        const gCheckHtml = (row) =>
            `<input type="checkbox" class="g-check accent-yellow-400" data-id="${row.id}" ${row.isLocal ? "disabled" : ""} ${selG.has(row.id) ? "checked" : ""} />`;
        const gThumbHtml = (row) =>
            `<div class="w-14"><img src="${gImgSrc(row)}" alt="${row.path}" loading="lazy" class="h-14 w-14 object-contain rounded bg-dark-900"></div>`;
        const gActionHtml = (row) =>
            row.isLocal
                ? `<span class="text-white/30 text-xs">Lokal</span>`
                : `<button type="button" class="g-del text-red-300/80 hover:text-red-300" data-id="${row.id}" data-path="${row.path}" title="Hapus">Hapus</button>`;

        function galleryFallback(data) {
            const tbody = document.querySelector("#tbl-gallery tbody");
            tbody.innerHTML = "";
            (data || []).forEach((row) => {
                const tr = document.createElement("tr");
                tr.innerHTML = `<td>${gCheckHtml(row)}</td>
                    <td>${gThumbHtml(row)}</td>
                    <td>${row.path}</td><td>${gActionHtml(row)}</td>`;
                const cb = tr.querySelector(".g-check");
                if (cb && !cb.disabled)
                    cb.addEventListener("change", function () {
                        if (this.checked) selG.add(row.id);
                        else selG.delete(row.id);
                        updateGalleryBulk();
                    });
                const delBtn = tr.querySelector(".g-del");
                if (delBtn)
                    delBtn.addEventListener("click", () => removeImage(row));
                tbody.appendChild(tr);
            });
            updateGalleryBulk();
        }

        function initGalleryTable(data) {
            galleryStore = data || [];
            countEl.textContent = `(${galleryStore.length})`;
            if (!window.jQuery || !window.jQuery.fn.DataTable) {
                galleryFallback(galleryStore);
                return;
            }
            if (gTable) gTable.destroy();
            gTable = $("#tbl-gallery").DataTable({
                data: galleryStore,
                columns: [
                    { data: null, orderable: false, render: (d) => gCheckHtml(d) },
                    { data: null, orderable: false, render: (d) => gThumbHtml(d) },
                    { data: "path" },
                    { data: null, orderable: false, render: (d) => gActionHtml(d) },
                ],
                columnDefs: [
                    {
                        targets: 0,
                        width: 40,
                        responsivePriority: 1,
                    },
                    {
                        targets: 1,
                        width: 64,
                        responsivePriority: 4,
                    },
                    {
                        targets: 2,
                        responsivePriority: 1,
                    },
                    {
                        targets: 3,
                        width: 80,
                        className: "text-center",
                        responsivePriority: 2,
                    },
                ],
                autoWidth: false,
                responsive: !!(window.jQuery && window.jQuery.fn.DataTable.Responsive),
                order: [[2, "asc"]],
                pageLength: 10,
                lengthMenu: [10, 20, 30, 40, 50],
