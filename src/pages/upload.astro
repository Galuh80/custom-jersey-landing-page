                        { data: "total", render: (d) => `<span class="text-brand-400">${fmt(d)}</span>` },
                        { data: null, orderable: false, render: (d) => nActionHtml(d) },
                    ],
                    columnDefs: [
                        {
                            targets: 0,
                            width: 40,
                            responsivePriority: 1,
                        },
                        {
                            targets: 1,
                            width: 150,
                            responsivePriority: 1,
                        },
                        {
                            targets: 2,
                            width: 130,
                            responsivePriority: 4,
                        },
                        {
                            targets: 3,
                            responsivePriority: 2,
                        },
                        {
                            targets: 4,
                            width: 130,
                            className: "text-right",
                            responsivePriority: 2,
                        },
                        {
                            targets: 5,
                            width: 140,
                            responsivePriority: 3,
                        },
                    ],
                    autoWidth: false,
                    responsive: !!(window.jQuery && window.jQuery.fn.DataTable.Responsive),
                    order: [[1, "desc"]],
                    pageLength: 10,
                    lengthMenu: [10, 20, 30, 40, 50],
                    language: {
                        url: "https://cdn.datatables.net/plug-ins/1.13.8/i18n/id.json",
