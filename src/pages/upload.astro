                $("#sel-all-n")
                    .off("change")
                    .on("change", function () {
                        $("#tbl-nota tbody .n-check").each(function () {
                            const id = $(this).data("id");
                            if (this.checked) selN.add(id);
                            else selN.delete(id);
                        });
                        updateNotaBulk();
                    });
                updateNotaBulk();
            }

            function updateNotaBulk() {
                document.getElementById("nota-bulk-count").textContent =
                    selN.size;
                document.getElementById("nota-bulk").disabled = selN.size === 0;
            }

            async function loadNotas() {
                const { data, error } = await supabase
                    .from("notas")
                    .select("id,nota_number,nota_date,customer_name,total,created_at")
                    .order("created_at", { ascending: false });
                if (error) {
                    notaStatusMsg("Gagal memuat nota: " + error.message, "error");
                    return;
                }
                initNotaTable(data || []);
            }

            async function fillNota(id) {
                const { data, error } = await supabase
                    .from("notas")
                    .select("*")
                    .eq("id", id)
                    .single();
                if (error || !data) {
                    notaStatusMsg("Gagal memuat nota.", "error");
                    return;
                }
                document.getElementById("nota-number").value = data.nota_number || "";
                document.getElementById("nota-date").value = (data.nota_date || "").slice(0, 10);
                document.getElementById("nota-customer").value = data.customer_name || "";
                document.getElementById("nota-wa-input").value = data.customer_wa || "";
                document.getElementById("nota-address").value = data.customer_address || "";
                document.getElementById("nota-discount").value = data.discount || 0;
                document.getElementById("nota-notes").value = data.notes || "";
                notaItemsTbody.innerHTML = "";
                (data.items || []).forEach((it) =>
                    itemRow(it.nama, it.qty, it.harga),
                );
                renderNota();
                notaStatusMsg("Nota dimuat.", "ok");
                setTab("nota");
            }

            async function deleteNota(id, no) {
                if (!window.confirm(`Hapus nota "${no}" ?`)) return;
                const { error } = await supabase
                    .from("notas")
                    .delete()
                    .eq("id", id);
                if (error) {
                    notaStatusMsg("Gagal hapus: " + error.message, "error");
                    return;
                }
                selN.delete(id);
                notaStatusMsg("Nota dihapus.", "ok");
                loadNotas();
            }

            async function removeSelectedNota() {
                const rows = notaStore.filter((r) => selN.has(r.id));
                if (!rows.length) return;
                if (!window.confirm(`Hapus ${rows.length} nota terpilih?`)) return;
                const ids = rows.map((r) => r.id);
                const { error } = await supabase
                    .from("notas")
                    .delete()
                    .in("id", ids);
                if (error) {
                    notaStatusMsg("Gagal hapus: " + error.message, "error");
                    return;
                }
                selN.clear();
                notaStatusMsg(`Dihapus ${rows.length} nota`, "ok");
                loadNotas();
            }

            document
                .getElementById("nota-bulk")
                .addEventListener("click", removeSelectedNota);

            document
                .getElementById("nota-print")
                .addEventListener("click", async () => {
                    try {
                        await saveNota();
                        notaStatusMsg("Tersimpan ke Supabase.", "ok");
                        loadNotas();
                    } catch (error) {
                        notaStatusMsg("Simpan gagal: " + error.message, "error");
                    }
                    setTimeout(() => window.print(), 200);
                });
            document
                .getElementById("nota-wa")
                .addEventListener("click", async () => {
                    try {
                        await saveNota();
                        notaStatusMsg("Tersimpan lalu kirim WA.", "ok");
                        loadNotas();
                    } catch (error) {
                        notaStatusMsg("Simpan gagal: " + error.message, "error");
                    }
                    renderNota();
                    const no =
                        document.getElementById("nota-number").value ||
                        "NOT-0000";
                    const customer =
                        document.getElementById("nota-customer").value || "-";
                    const items = readItems();
                    const lines = items
                        .map((it) => `• ${it.nama || "-"} x${it.qty} = ${fmt(it.qty * it.harga)}`)
                        .join("\n");
                    const { total } = updateTotals();
                    const msg = [
                        `NOTA ONLINE ${STORE.name}`,
                        `No: ${no}`,
                        `Tanggal: ${document.getElementById("nota-date").value || dateToday()}`,
                        `Pelanggan: ${customer}`,
                        ``,
                        lines || "• -",
                        ``,
                        `Total: ${fmt(total)}`,
                        ``,
                        document.getElementById("nota-notes").value || "",
                    ]
                        .filter((line) => line !== "")
                        .join("\n");
                    let target = STORE.wa;
                    const waRaw = document
                        .getElementById("nota-wa-input")
                        .value.replace(/\D/g, "");
                    if (waRaw) {
                        target = waRaw.startsWith("0")
                            ? "62" + waRaw.slice(1)
                            : waRaw;
                    }
                    window.open(
                        "https://wa.me/" +
                            target +
                            "?text=" +
                            encodeURIComponent(msg),
                        "_blank",
                    );
                });

            document
                .getElementById("nota-refresh")
                .addEventListener("click", loadNotas);

            // Initialise nota
            loadNotas();
            document.getElementById("nota-date").value = dateToday();
            document.getElementById(
                "nota-number",
            ).value = "NOT-" + dateToday().replaceAll("-", "") + "-001";
            itemRow();
            renderNota();
        }
    </script>
</Layout>
