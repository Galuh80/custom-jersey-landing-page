                    </div>
                    <button type="button" class="del-row col-span-2 sm:col-span-1 justify-self-end sm:justify-self-auto sm:text-center text-red-300/80 hover:text-red-300 text-sm sm:text-lg leading-none"><span class="sm:hidden">Hapus</span><span class="hidden sm:inline">&times;</span></button>
                `;
                notaItemsTbody.appendChild(row);
            }

            function readItems() {
                return Array.from(
                    notaItemsTbody.querySelectorAll(".nota-row"),
                ).map((row) => ({
                    nama: row.querySelector(".f-nama").value,
                    qty: Math.max(
                        1,
                        parseInt(row.querySelector(".f-qty").value, 10) || 1,
                    ),
                    harga:
                        parseInt(row.querySelector(".f-harga").value, 10) || 0,
                }));
            }

            function updateTotals() {
                const rows = notaItemsTbody.querySelectorAll(".nota-row");
                let subtotal = 0;
                rows.forEach((row) => {
                    const qty =
                        Math.max(
                            1,
                            parseInt(row.querySelector(".f-qty").value, 10) || 1,
                        );
                    const harga =
                        parseInt(row.querySelector(".f-harga").value, 10) || 0;
                    const jumlah = qty * harga;
                    row.querySelector(".f-jumlah").textContent = fmt(jumlah);
                    subtotal += jumlah;
                });
                const discount = Math.max(
                    0,
                    parseInt(
                        document.getElementById("nota-discount").value,
                        10,
                    ) || 0,
                );
                const total = Math.max(0, subtotal - discount);
                notaTotal.textContent = "Total: " + fmt(total);
                return { subtotal, discount, total };
            }

            function esc(s) {
                return (s || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            function renderNota() {
                const no =
                    document.getElementById("nota-number").value || "NOT-0000";
                const date = document.getElementById("nota-date").value || dateToday();
                const customer =
                    document.getElementById("nota-customer").value || "-";
                const notes =
                    document.getElementById("nota-notes").value || "";
                const items = readItems();
                const { subtotal, discount, total } = updateTotals();
                const tgl = date
                    ? new Date(date + "T00:00:00").toLocaleDateString("id-ID", {
