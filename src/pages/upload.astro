                        <div class="text-xs text-slate-500">${esc(STORE.address)}</div>
                      </div>
                    </div>
                    <div class="text-right text-xs text-slate-500">
                      <div>WA: ${esc(STORE.phone)}</div>
                      <div>${esc(STORE.ig)}</div>
                    </div>
                  </div>

                  <div class="text-center my-3">
