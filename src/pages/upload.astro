                const idleTab =
                    "px-4 py-2 rounded-lg text-sm font-medium transition bg-white/5 text-white/70 hover:bg-white/10";
                tabUpload.className = onUpload ? activeTab : idleTab;
                tabNota.className = onUpload ? idleTab : activeTab;
