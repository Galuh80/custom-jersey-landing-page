                    .off("click", ".n-load")
                    .on("click", ".n-load", function () {
                        fillNota($(this).data("id"));
                    });
                $("#tbl-nota tbody")
                    .off("click", ".n-del")
                    .on("click", ".n-del", function () {
                        deleteNota($(this).data("id"), $(this).data("no"));
